# versions.env — pinned build inputs for the netboot iPXE builder (AUDIT F5).
#
# SOURCED by build-ipxe.sh (treat it as code, not data — AUDIT F3).
#
# WHY A SHA AND NOT JUST A TAG. A git tag is a mutable pointer: upstream can
# move it, and a re-tagged v2.0.0 would build different bytes under the same
# name with nothing to notice.  "A version string is not an identity; compare
# hashes."  So the ref is recorded WITH the commit it resolved to, and
# ipxe-build-inner.sh refuses a mismatch BY NAME rather than building on.
#
# Refresh (both lines together, or the pin is a lie):
#   git ls-remote --tags https://github.com/ipxe/ipxe.git | tail
#   git ls-remote https://github.com/ipxe/ipxe.git refs/tags/<newtag>^{}
#     (the ^{} form dereferences an annotated tag to the commit it points at;
#      without it you get the tag object's own hash, which is not what
#      `git rev-parse HEAD` reports after a clone)

# ── iPXE source ─────────────────────────────────────────────────────────────
# v2.0.0, released 2026-03-06 — upstream's first tag since v1.21.1 (2020-12).
# That gap is why this default was `master` for so long: until v2.0.0 there was
# no release recent enough to carry the features this pipeline compiles in
# (IMAGE_TRUST_CMD for --imgverify, CONSOLE_SERIAL for --serial-console, and
# the riscv64 EFI target, which needs a 2023+ tree).
IPXE_REF=v2.0.0
IPXE_COMMIT=12798ec29aa8a64d8675c4378b99f5fe28447afb

# ── Build container base — PINNED BY DIGEST ─────────────────────────────────
# Refresh with:  docker pull debian:bookworm && \
#                docker image inspect debian:bookworm --format '{{index .RepoDigests 0}}'
#          (or:  skopeo inspect docker://debian:bookworm --format '{{.Digest}}')
IPXE_BUILD_IMAGE="debian:bookworm@sha256:813017f3d62be4b5891a7acca6a01bdcd4b8513daa81b1ab99d3a50385b26931"
