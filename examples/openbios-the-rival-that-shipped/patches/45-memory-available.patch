+++ b/include/libopenbios/sys_info.h
@@ -6,6 +6,11 @@
 /* Publishes the map below into /memory's `reg`; see libopenbios/init.c. */
 struct sys_info;
 extern void publish_memory_ranges(struct sys_info *info);
+/* /memory's `available` -- the still-free part of the arch allocator's window.
+ * Call it again on every claim and release: it describes a cursor that moves,
+ * and a snapshot taken once is stale from the first allocation. */
+extern void publish_memory_available(unsigned long long start,
+                                     unsigned long long end);
 
 struct sys_info {
     /* Values passed by bootloader */
--- a/arch/x86/openbios.c
+++ b/arch/x86/openbios.c
@@ -171,6 +171,17 @@
 
 static unsigned long claim_next = CLAIM_BASE_PHYS;
 
+/* TODO 17.3: /memory's `available` is the still-free part of THIS window, and
+ * it is republished on every claim and release rather than snapshotted at boot.
+ * The property describes a cursor that moves; publishing it once would be a
+ * record that outlives its subject the first time a client allocates. */
+static void
+x86_publish_available( void )
+{
+	publish_memory_available((unsigned long long)claim_next,
+				 (unsigned long long)virt_to_phys(0));
+}
+
