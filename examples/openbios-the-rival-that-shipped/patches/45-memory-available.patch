-	if (acells < 1 || acells > 2 || scells < 1 || scells > 2) {
+	if (*acells < 1 || *acells > 2 || *scells < 1 || *scells > 2) {
 		printk("/memory: root declares #address-cells %d / #size-cells %d, "
-		       "which this does not encode -- leaving reg unset\n", acells, scells);
+		       "which this does not encode -- leaving %s unset\n",
+		       *acells, *scells, what);
+		return -1;
+	}
+	return 0;
+}
+
+/* publish_memory_available -- /memory's `available`, the UNALLOCATED subset.
+ *
+ * WHY IT IS NOT PUBLISHED ONCE. `available` describes a cursor that MOVES: the
+ * whole point of the property is what is free NOW, and a snapshot taken at boot
+ * is a record that outlives its subject the first time a client claims. So the
+ * arch allocators call this again on every claim and every release, which is
+ * what libopenbios/ofmem_common.c's ofmem_update_memory_available() does for the
+ * arches that have ofmem. x86 and amd64 do not.
+ *
+ * IT IS DELIBERATELY NARROWER THAN "ALL UNALLOCATED RAM", and that direction is
+ * chosen. Both PC arches allocate with a bump allocator over ONE window, so any
+ * RAM outside that window -- everything above 4 GiB included -- is in `reg` and
+ * will be REFUSED by `claim`. Advertising it would be advertising memory the
+ * firmware will not give you, and a client that believes `available` and then
+ * gets -1 has been lied to. Under-reporting only costs a client an option it
+ * never had.
+ *
+ * An EMPTY window publishes a zero-length property rather than no property:
+ * "nothing is free" and "nobody has said" are different answers, and a client
+ * cannot tell them apart from an absent property. */
+void publish_memory_available(unsigned long long start, unsigned long long end)
+{
+	phandle_t mem;
+	u32 cells[4], *p;
+	int acells, scells;
+
+	mem = find_dev("/memory");
+	if (!mem)
+		return;
+	if (memory_root_cells(&acells, &scells, "available"))
+		return;
+
+	if (end <= start) {
+		set_property(mem, "available", (char *)cells, 0);
+		return;
+	}
+	/* A window this cannot encode is a window a client must not be told about:
+	 * truncating it would name a different region entirely. */
+	if ((acells == 1 && (start >> 32)) || (scells == 1 && ((end - start) >> 32))) {
+		/* %llx, not FMT_ucellx: ucell is 32 bits on x86 and the whole point
+		 * of this branch is a value that does not fit in 32. libc/vsprintf.c
+		 * implements long long (TODO 13.3(E), patch 30 ran it for the first
+		 * time). */
+		printk("/memory: the free window %llx..%llx does not fit "
+		       "#address-cells %d / #size-cells %d -- leaving available unset\n",
+		       start, end, acells, scells);
 		return;
 	}
+	p = emit_cells(cells, start, acells);
+	p = emit_cells(p, end - start, scells);
+	set_property(mem, "available", (char *)cells,
+		     (int)((p - cells) * sizeof(u32)));
+}
+
+void publish_memory_ranges(struct sys_info *info)
+{
+	phandle_t mem;
+	u32 *cells, *p;
+	int i, acells, scells, emitted = 0, dropped = 0;
+
+	if (!info || info->n_memranges <= 0)
+		return;
+	mem = find_dev("/memory");
+	if (!mem)
+		return;
+	if (memory_root_cells(&acells, &scells, "reg"))
+		return;
 
 	cells = malloc(info->n_memranges * (acells + scells) * sizeof(u32));
 	if (!cells)
