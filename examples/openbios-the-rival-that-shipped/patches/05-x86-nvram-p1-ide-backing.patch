# patches/05-x86-nvram-p1-ide-backing.patch — P1 of the persistence ladder:
# the store gets a real backing. Applies on top of 04-x86-nvram-p0.patch.
#
# Adds WIN_WRITE (absent upstream: ide.h defined only reads), a PIO data-out
# transport mirroring data-in, an LBA28 write, and a by-number drive registry
# so arch code can reach a drive at all. arch_nvram_get/put then read and write
# raw sectors on ide@3 -- touching NO filesystem, partition or disk-label code,
# all of which are read-only and none of which an NVRAM needs.
#
# It REFUSES to write to a drive whose first 8 KiB is neither blank nor already
# an nvram store, and it refuses BEFORE the write, not after.
#
# Verified by: ./smoke-openbios.sh persist

--- a/drivers/ide.h
+++ b/drivers/ide.h
@@ -50,6 +50,7 @@
  */
 #define WIN_READ		0x20
 #define WIN_READ_EXT		0x24
+#define WIN_WRITE		0x30	/* P1: absent upstream -- ide.h defined only reads */
 #define WIN_IDENTIFY		0xEC
 #define WIN_PACKET		0xA0
 #define WIN_IDENTIFY_PACKET	0xA1
--- a/drivers/ide.c
