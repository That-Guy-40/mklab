@@ -264,7 +324,7 @@
 	 * -- no banner, no reason, indistinguishable from a broken image. A
 	 * step that can fail belongs downstream of the thing that reports. */
 	nvram_init("/");
-	/* BISECT: nvconf_init(); */
+	nvconf_init();
 
