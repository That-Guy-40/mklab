 /* ------------------------------------------------------------------ *
- * P0: an NVRAM that exists.
+ * P0/P1: the NVRAM store.
  *
- * packages/nvram.c has been compiled into every x86 build for years with no
- * x86 caller, because the three hooks below were defined only by the ppc
- * boards. Wiring them makes `dev / ls` show an `nvram` node and gives the
- * config variables in forth/admin/nvram.fs somewhere to live.
+ * P0 replaced three stubs in entry.S that LIED -- arch_nvram_size returned 0
+ * and get/put were a bare `ret`, so a caller got silent success and an empty
+ * store. Nothing noticed for years because arch/x86 never called nvram_init().
  *
- * THE BACKING IS DELIBERATELY VOLATILE. This rung proves the package
- * instantiates and the format round-trips; it persists NOTHING, and the
- * ladder's P2 checkpoint (a value surviving a fresh QEMU process) must FAIL
- * against this buffer. That failure is the control for P1's real backing --
- * if P2 passed here, it would be measuring dictionary state rather than
- * storage, which is exactly the illusion this whole exercise started from.
+ * P1 gives the buffer a backing: raw sectors on a dedicated IDE drive. Note
+ * what this does NOT touch -- disk-label, pc-parts, and every filesystem in
+ * fs/ are read-only, and none of them is in the path. arch_nvram_* is arch
+ * code: it needs raw bytes at a fixed place, not a file. That is why the write
+ * path costs one function in the driver instead of five layers above it.
  *
- * Sized 8 KiB: nvconf_init() asks for a DEF_SYSTEM_SIZE (0xc10 = 3088 byte)
- * system partition, so anything smaller is silently clamped by
- * create_nv_part(). briq's 2048 is below that line and takes the clamp.
+ * THE DRIVE IS NOT GUESSED. LAB_NVRAM_DRIVE names a unit that the lab attaches
+ * on purpose and nothing else uses. Writing sectors on whatever happens to be
+ * unit 0 would eat the boot disk of anyone who ran this with a real image
+ * attached -- so the store REFUSES to write unless the drive it was handed
+ * still looks like the store (see nvram_backing_ok below). A gate after the
+ * write is a post-mortem, not a gate.
  * ------------------------------------------------------------------ */
-static char x86_nvram[8192];
+#define LAB_NVRAM_DRIVE   3          /* secondary slave: ide@3 */
+#define LAB_NVRAM_SECTORS 16         /* 16 * 512 = 8 KiB */
+
+static char x86_nvram[LAB_NVRAM_SECTORS * 512];
+static int  x86_nvram_backed;        /* 1 once a real drive answered */
+
+/*
+ * Refuse a drive that is carrying someone else's data. The store is either
+ * blank (a fresh image, all zeros) or already ours (nvram.c's partition format
+ * puts a signature byte and a 12-char name in the first 16 bytes, and the free
+ * partition it creates is named "77777777777"). Anything else -- a partition
+ * table, a filesystem superblock, a kernel -- and we keep the volatile buffer
+ * and say so, rather than overwrite it.
+ */
+static int nvram_backing_ok(const unsigned char *buf, int len)
+{
+	int i, blank = 1;
+
+	for (i = 0; i < len; i++)
+		if (buf[i]) { blank = 0; break; }
+	if (blank)
+		return 1;
+
+	/* nvram.c's own partition names, at the documented offsets */
+	if (!memcmp(buf + 4, "77777777777", 11))
+		return 1;
+	if (!memcmp(buf + 4, "common", 6))
+		return 1;
+
+	return 0;
+}
 
 int
 arch_nvram_size( void )
@@ -211,6 +242,25 @@
 void
 arch_nvram_get( char *buf )
 {
+	unsigned char *p = (unsigned char *)x86_nvram;
+
+	x86_nvram_backed = 0;
+
+	if (!ob_ide_read_blocks_nr(LAB_NVRAM_DRIVE, 0, p, LAB_NVRAM_SECTORS)) {
+		if (nvram_backing_ok(p, sizeof(x86_nvram))) {
+			x86_nvram_backed = 1;
+		} else {
+			printk("nvram: ide@%d holds data that is not an nvram store"
+			       " -- refusing to write to it; using a volatile buffer\n",
+			       LAB_NVRAM_DRIVE);
+			memset(x86_nvram, 0, sizeof(x86_nvram));
+		}
+	} else {
+		printk("nvram: no drive at ide@%d -- using a volatile buffer\n",
+		       LAB_NVRAM_DRIVE);
+		memset(x86_nvram, 0, sizeof(x86_nvram));
+	}
+
 	memcpy( buf, x86_nvram, sizeof(x86_nvram) );
 }
 
@@ -218,6 +268,16 @@
 arch_nvram_put( char *buf )
 {
 	memcpy( x86_nvram, buf, sizeof(x86_nvram) );
+
+	if (!x86_nvram_backed) {
+		printk("nvram: not backed -- this change will NOT survive a reset\n");
+		return;
+	}
+
+	if (ob_ide_write_blocks_nr(LAB_NVRAM_DRIVE, 0,
+	                           (unsigned char *)x86_nvram, LAB_NVRAM_SECTORS))
+		printk("nvram: WRITE FAILED to ide@%d -- the store on disk is now"
+		       " out of date\n", LAB_NVRAM_DRIVE);
 }
 
