 /*
  * execute given command with a pio data-in phase.
  */
+/*
+ * P1: the mirror of ob_ide_pio_data_in below.
+ *
+ * Everything up to the transfer is identical -- select, wait, write the task
+ * file -- because it is the same protocol; only the direction of the data
+ * register changes, and ob_ide_pio_outsw already existed and was already used
+ * (the ATAPI packet path). This is why "add a write path" costs one function
+ * here rather than five layers up in the filesystem stack.
+ */
+static int
+ob_ide_pio_data_out(struct ide_drive *drive, struct ata_command *cmd)
+{
+	unsigned char stat;
+	unsigned int bytes, timeout;
+
+	if (ob_ide_select_drive(drive))
+		return 1;
+
+	timeout = 0;
+	do {
+		stat = ob_ide_pio_readb(drive, IDEREG_STATUS);
+		if ((stat & (BUSY_STAT | READY_STAT)) == READY_STAT)
+			break;
+		ob_ide_400ns_delay(drive);
+	} while (timeout++ < 1000);
+
+	if (timeout >= 1000) {
+		ob_ide_error(drive, stat, "drive timed out");
+		cmd->stat = stat;
+		return 1;
+	}
+
+	ob_ide_write_registers(drive, cmd);
+
+	bytes = cmd->buflen;
+	do {
+		unsigned count = cmd->buflen;
+
+		if (count > drive->bs)
+			count = drive->bs;
+
+		if (ob_ide_wait_stat(drive, 0, BUSY_STAT | ERR_STAT, &stat)) {
+			ob_ide_error(drive, stat, "timed out waiting for BUSY clear");
+			cmd->stat = stat;
+			break;
+		}
+
+		if ((stat & (BUSY_STAT | DRQ_STAT)) == DRQ_STAT) {
+			ob_ide_pio_outsw(drive, IDEREG_DATA, cmd->buffer, count);
+			cmd->bytes -= count;
+			cmd->buffer += count;
+			bytes -= count;
+
+			ob_ide_400ns_delay(drive);
+		}
+
+		if (stat & (BUSY_STAT | WRERR_STAT | ERR_STAT)) {
+			cmd->stat = stat;
+			break;
+		}
+
+		if (!(stat & DRQ_STAT)) {
+			cmd->stat = stat;
+			break;
+		}
+	} while (bytes);
+
+	/*
+	 * A write is not on the platter when the last DRQ clears. Wait for the
+	 * drive to go READY with no error before calling it done -- otherwise
+	 * "the write succeeded" is a claim about the bus, not about storage,
+	 * which is the whole distinction this rung exists to make.
+	 */
+	if (!bytes && ob_ide_wait_stat(drive, READY_STAT, BUSY_STAT | ERR_STAT, &stat)) {
+		ob_ide_error(drive, stat, "write did not complete");
+		cmd->stat = stat;
+		return 1;
+	}
+
+	return bytes ? 1 : 0;
+}
+
 static int
 ob_ide_pio_data_in(struct ide_drive *drive, struct ata_command *cmd)
 {
@@ -868,6 +950,93 @@
 }
 
 /*
+ * P1: LBA28 write. Deliberately NOT a full mirror of the read side -- there is
+ * no CHS and no LBA48 variant, because the NVRAM store this exists for lives in
+ * the first few sectors of a small dedicated image. A caller asking for anything
+ * outside LBA28 is REFUSED rather than silently served by a path nobody has
+ * exercised.
+ */
+static int
+ob_ide_write_ata_lba28(struct ide_drive *drive, unsigned long long block,
+                       unsigned char *buf, unsigned int sectors)
+{
+	struct ata_command *cmd = &drive->channel->ata_cmd;
+
+	memset(cmd, 0, sizeof(*cmd));
+
+	cmd->buffer = buf;
+	cmd->buflen = sectors * 512;
+
+	cmd->nsector = sectors;
+	cmd->sector  = block;
+	cmd->lcyl    = block >>= 8;
+	cmd->hcyl    = block >>= 8;
+	cmd->device_head  = ((block >> 8) & 0x0f);
+	cmd->device_head |= (1 << 6);
+
+	cmd->command = WIN_WRITE;
+
+	return ob_ide_pio_data_out(drive, cmd);
+}
+
+static int
+ob_ide_write_sectors(struct ide_drive *drive, unsigned long long block,
+                     unsigned char *buf, unsigned int sectors)
+{
+	if (!sectors)
+		return 1;
+	if (block + sectors > drive->sectors)
+		return 1;
+	if (drive->type != ide_type_ata)
+		return 1;               /* no ATAPI writes: not what this is for */
+	if (block + sectors > (1ULL << 28) || sectors > 255)
+		return 1;               /* outside LBA28 -- refuse, see above */
+	if (drive->addressing == ide_chs)
+		return 1;               /* CHS write path deliberately not written */
+
+	return ob_ide_write_ata_lba28(drive, block, buf, sectors);
+}
+
+/*
+ * P1: the one hook arch code needs.
+ *
+ * The channels are malloc'd inside ob_ide_init() and never kept anywhere a
+ * caller could reach, so arch_nvram_* had nothing to talk to. This registry is
+ * the smallest thing that fixes it: remember drives as they are probed and hand
+ * one back BY NUMBER.
+ */
+static struct ide_drive *ob_ide_drives[IDE_MAX_CHANNELS * 2];
+
+static void ob_ide_register_drive(struct ide_drive *d)
+{
+	if (d->nr >= 0 && d->nr < (int)(sizeof(ob_ide_drives)/sizeof(ob_ide_drives[0])))
+		ob_ide_drives[d->nr] = d;
+}
+
+static struct ide_drive *ob_ide_drive_by_nr(int nr)
+{
+	if (nr < 0 || nr >= (int)(sizeof(ob_ide_drives)/sizeof(ob_ide_drives[0])))
+		return NULL;
+	if (!ob_ide_drives[nr] || !ob_ide_drives[nr]->present)
+		return NULL;
+	return ob_ide_drives[nr];
+}
+
+int ob_ide_read_blocks_nr(int nr, unsigned long long block,
+                          unsigned char *buf, unsigned int sectors)
+{
+	struct ide_drive *d = ob_ide_drive_by_nr(nr);
+	return d ? ob_ide_read_sectors(d, block, buf, sectors) : 1;
+}
+
+int ob_ide_write_blocks_nr(int nr, unsigned long long block,
+                           unsigned char *buf, unsigned int sectors)
+{
+	struct ide_drive *d = ob_ide_drive_by_nr(nr);
+	return d ? ob_ide_write_sectors(d, block, buf, sectors) : 1;
+}
+
+/*
  * byte swap the string if necessay, and strip leading/trailing blanks
  */
 static void
