+	feval("load-size");
+	if (!elf_gate(ehdr, (unsigned long)base, (unsigned long)POP()))
+		return;
+
 	phdr = (Elf_phdr *)(base + ehdr->e_phoff);
 
 	for (i = 0; i < ehdr->e_phnum; i++) {
--- a/libopenbios/initprogram.c
+++ b/libopenbios/initprogram.c
@@ -42,6 +42,17 @@
 	feval("load-base");
 	addr = POP();
 
+	/* LOCAL DIVERGENCE (mklab, patch 68). state-valid is a record about the
+	 * image at load-base, and only the *_init_program() that accepts an image
+	 * ever wrote it -- so a load that no loader recognised left the value the
+	 * PREVIOUS load had set, and `go` would have re-entered that stale image.
+	 * Measured 2026-09-05 on amd64: after a client program (state-valid -1),
+	 * `load` of an unrecognised ELF64 printed ok and state-valid still read
+	 * -1. Every C loader's load path (elf_load, forth_load, fcode_load...)
+	 * zeroes it first; the init-program path now does too, before it decides
+	 * whether anything here is runnable. */
+	feval("0 state-valid !");
+
 #ifdef CONFIG_LOADER_AOUT
 	if (is_aout((struct exec *)cell2pointer(addr))) {
 		aout_init_program();
@@ -98,6 +109,21 @@
 	}
 #endif
 
+	/* patch 68: nothing claimed the image. Upstream returned in silence here
+	 * and the only symptom was `go` saying "No valid state" some time later.
+	 * An ELF that is not this firmware's is the case worth naming by field
+	 * (a kernel for the wrong CPU is what a person actually boots by
+	 * mistake); anything else is named by its first bytes. */
+	{
+		const unsigned char *b = (const unsigned char *)cell2pointer(addr);
+#ifdef CONFIG_LOADER_ELF
+		if (elf_explain_not_ours(b))
+			return;
+#endif
+		printk("init-program: no loader recognised the image at load-base "
+		       "(first bytes %02x %02x %02x %02x) -- state-valid stays 0\n",
+		       b[0], b[1], b[2], b[3]);
+	}
 }
 
