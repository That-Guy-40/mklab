+/* LOCAL DIVERGENCE (mklab, patch 68): the ELF gate in elf_init_program().
+ * elf_segments_placeable is 1 everywhere a client program can be entered and
+ * 0 on the hosted target (arch/unix sets it: its start_elf() is a stub), where
+ * copying segments to their p_vaddr would write into a host process that has
+ * nothing mapped there. elf_explain_not_ours() is what init_program() calls
+ * when the bytes carry the ELF magic but is_elf() said no: it names the field. */
+extern int		elf_segments_placeable;
+extern int		elf_explain_not_ours(const unsigned char *base);
+
 #endif   /* _H_ELFLOAD */
