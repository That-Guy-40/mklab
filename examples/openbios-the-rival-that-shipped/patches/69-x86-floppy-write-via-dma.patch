+	/* Arm the 8237 for this sector, then enable DMA on the controller (OR the
+	 * bit in -- set_drive leaves the drive/motor bits we must keep). */
+	floppy_dma_setup_write(FLOPPY_DMA_BOUNCE_PHYS, 512);
+	set_dor(0xff, DOR_DMA_EN);
 
 	cmd[0] = FD_WRITE & ~0x80;      /* MFM, single sector: MT cleared */
 	cmd[1] = (head << 2) | FD_DRIVE;
