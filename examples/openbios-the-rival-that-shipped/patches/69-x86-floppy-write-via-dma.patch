+ * THE BOUNCE. ISA DMA addresses only the low 16 MiB, but OpenBIOS x86 relocates
+ * itself to the top of RAM -- virt_to_phys(a heap buffer) is ~512 MiB, out of
+ * the 8237's reach. So the sector is staged in a fixed low page
+ * (FLOPPY_DMA_BOUNCE_PHYS), which phys_to_virt() reaches exactly (flat segment,
+ * no paging -- verified from outside the guest with QEMU's monitor, TODO 24.1).
  */
 static int floppy_write_sector(const char *src, unsigned sector,
                                unsigned head, unsigned track)
 {
-	int i, status;
+	volatile unsigned char *bounce;
