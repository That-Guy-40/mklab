--- a/libopenbios/linuxbios_info.c
+++ b/libopenbios/linuxbios_info.c
@@ -7,6 +7,9 @@
 #include "linuxbios.h"
 #include "libopenbios/ipchecksum.h"
 #include "libopenbios/sys_info.h"
+#include "libopenbios/bindings.h"
+#include "libc/stdlib.h"
+#include "libc/string.h"
 
 #ifdef CONFIG_DEBUG_BOOT
 #define debug printk
@@ -140,25 +143,107 @@
 	return 0;
 }
 
-void collect_linuxbios_info(struct sys_info *info)
+/* The search, on its own, so it can be run more than once (patch 58). The two
+ * windows and the forward chase are collect_linuxbios_info()'s, unchanged. */
+static struct lb_header *lb_find_table(void)
 {
 	struct lb_header *lb_table, *fwd_table;
 	int found;
+
 	debug("Searching for LinuxBIOS tables...\n");
-	found = 0;
+	found = find_lb_table(phys_to_virt(0x00000), phys_to_virt(0x01000),
+			      &lb_table);
 	if (!found) {
-		found = find_lb_table(phys_to_virt(0x00000), phys_to_virt(0x01000), &lb_table);
-	}
-	if (!found) {
-		found = find_lb_table(phys_to_virt(0xf0000), phys_to_virt(0x100000), &lb_table);
+		found = find_lb_table(phys_to_virt(0xf0000),
+				      phys_to_virt(0x100000), &lb_table);
 	}
 	if (!found)
-		return;
+		return NULL;
 
 	if (forward_lb_table(lb_table, &fwd_table))
 		lb_table = fwd_table;
 
+	return lb_table;
+}
+
+void collect_linuxbios_info(struct sys_info *info)
+{
+	struct lb_header *lb_table = lb_find_table();
+
+	if (!lb_table)
+		return;
+
 	debug("Found LinuxBIOS table at: %p\n", lb_table);
 	info->firmware = "LinuxBIOS";
 	read_lbtable(lb_table, info);
 }
+
+/* -- mklab, B.3 Spike 3 (patch 58): the walk, and the region it walks ---------
+ * B.3's remaining success-signature clause is "a region diff shows a
+ * firmware-caused change", and the change has to come from a code path that is
+ * already in the tree -- otherwise the diff is showing the test's own writing.
+ * This parser is that path: it runs once at init, it is the one this lab
+ * patched twice (01 and 39), and re-running it is a whole in-tree behaviour
+ * repeated on demand rather than a poke staged to be found.
+ *
+ * `lb-table ( -- phys len )` is the region the walk READS -- the CBMEM-
+ * forwarded table, header included. The review that scheduled this work
+ * expected the diff to appear there; measured 2026-09-03, it does not, and
+ * that is the point of publishing it: read_lbtable() is a reader, so the
+ * region it walks is the NEGATIVE control, not the subject.
+ *
+ * `lb-walk ( -- n )` re-runs the parse into a scratch sys_info -- the live one
+ * is never touched -- and answers with the number of RAM ranges it wrote, or
+ * -1 when no table was found (a non-coreboot boot). What it DOES leave behind
+ * is an allocation: convert_memmap() mallocs and fills it, so the bytes at
+ * malloc_cursor_phys() are the subject, and the firmware wrote them.
+ *
+ * Addresses out are PHYSICAL, because x86 relocates and a bare pointer handed
+ * to Forth would let a snapshot land on RAM that reads back convincingly.
+ */
+static unsigned long lb_table_phys(void)
+{
+	struct lb_header *head = lb_find_table();
+
+	return head ? virt_to_phys(head) : 0;
+}
+
+static unsigned long lb_table_len(void)
+{
+	struct lb_header *head = lb_find_table();
+
+	return head ? (unsigned long)(sizeof(*head) + head->table_bytes) : 0;
+}
+
+static void forth_lb_table(void)
+{
+	PUSH(lb_table_phys());
+	PUSH(lb_table_len());
+}
+
+static void forth_lb_walk(void)
+{
+	struct lb_header *head = lb_find_table();
+	struct sys_info scratch;
+
+	if (!head) {
+		PUSH((ucell)-1);
+		return;
+	}
+	memset(&scratch, 0, sizeof(scratch));
+	read_lbtable(head, &scratch);
+	PUSH((ucell)scratch.n_memranges);
+}
+
+static void forth_heap_cursor(void)
+{
+	PUSH(malloc_cursor_phys());
+	PUSH(malloc_avail());
+}
+
+void ob_lb_bind_words(void)
+{
+	bind_func("lb-table", forth_lb_table);
+	bind_func("lb-walk", forth_lb_walk);
+	bind_func("heap-cursor", forth_heap_cursor);
+}
