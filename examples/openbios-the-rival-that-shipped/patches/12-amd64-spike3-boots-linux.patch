+static void hardware_setup(void)
+{
+    /* Disable nmi */
+    outb(0x80, 0x70);
+
+    /* Make sure any coprocessor is properly reset.. */
+    outb(0, 0xf0);
+    outb(0, 0xf1);
+
+    /* we're getting screwed again and again by this problem of the 8259.
+     * so we're going to leave this lying around for inclusion into
+     * crt0.S on an as-needed basis.
+     *
+     * well, that went ok, I hope. Now we have to reprogram the interrupts :-(
+     * we put them right after the intel-reserved hardware interrupts, at
+     * int 0x20-0x2F. There they won't mess up anything. Sadly IBM really
+     * messed this up with the original PC, and they haven't been able to
+     * rectify it afterwards. Thus the bios puts interrupts at 0x08-0x0f,
+     * which is used for the internal hardware interrupts as well. We just
+     * have to reprogram the 8259's, and it isn't fun.
+     */
+
+    outb(0x11, 0x20);		/* initialization sequence to 8259A-1 */
+    outb(0x11, 0xA0);		/* and to 8259A-2 */
+
+    outb(0x20, 0x21);		/* start of hardware int's (0x20) */
+    outb(0x28, 0xA1);		/* start of hardware int's 2 (0x28) */
+
+    outb(0x04, 0x21);		/* 8259-1 is master */
+    outb(0x02, 0xA1);		/* 8259-2 is slave */
+
+    outb(0x01, 0x21);		/* 8086 mode for both */
+    outb(0x01, 0xA1);
+
+    outb(0xFF, 0xA1);		/* mask off all interrupts for now */
+    outb(0xFB, 0x21);		/* mask all irq's but irq2 which is cascaded */
+}
+
+/* Start Linux -- the 64-bit entry.
+ *
+ * THIS IS THE ONE PLACE THE PORT IS NOT A TRANSCRIPTION, and the trap is that
+ * transcribing x86's handoff very nearly works. x86 hands over with
+ * switch_to(): it fills a context frame with cs/ds/ss/gdt_base and lets the
+ * switch reload them. arch/amd64's frame carries NONE of those -- context.h
+ * says so on purpose, because long mode ignores segment bases and the firmware
+ * and its clients share the one flat GDT the trampoline built. The frame does
+ * carry rsi, which is exactly the register the 64-bit boot protocol wants
+ * boot_params in, and that near-miss is what makes the wrong answer look
+ * right: set ctx->rip and ctx->rsi, call switch_to(), and the kernel is
+ * entered -- on the FIRMWARE's GDT.
+ *
+ * Documentation/arch/x86/boot.rst, "64-bit Boot Protocol", is unambiguous:
+ *
+ *     a GDT must be loaded with the descriptors for selectors __BOOT_CS(0x10)
+ *     and __BOOT_DS(0x18); both descriptors must be 4G flat segment; ...
+ *     CS must be __BOOT_CS and DS, ES, SS must be __BOOT_DS; interrupt must
+ *     be disabled; %rsi must hold the base address of the struct boot_params.
+ *
+ * The live long-mode GDT is gdt64 in arch/amd64/switch.S -- three entries:
+ * null, 0x08 = 64-bit code (L=1), 0x10 = data. Note what that means: the
+ * selector the kernel requires for CODE is the one this firmware uses for
+ * DATA, and 0x18 does not exist at all. Nothing in switch_to() can fix that.
+ *
+ * (arch/amd64/segment.c's gdt[] is NOT the live table -- it is the 32-bit
+ * descriptor set inherited from x86, unused once the trampoline runs. Reusing
+ * its FLAT_CODE/FLAT_DATA here would build the Linux GDT out of descriptors
+ * the CPU is not currently executing on.)
+ *
+ * And the handoff has a second job the x86 one never had: see the comment on
+ * linux_handoff in switch.S. The firmware occupies the address the kernel has
+ * to run at, so the last act is to copy the kernel over the firmware from a
+ * stub parked outside both.
+ */
+
+/* The blob in switch.S, and its extent. Copied, then called at its copy. */
+extern char linux_handoff[], linux_handoff_end[];
+
+typedef void (*handoff_fn)(uint64_t entry, uint64_t boot_params, void *gdt_desc,
+			   uint64_t src, uint64_t dst, uint64_t len);
+
+/* The handoff apparatus lives in one contiguous block of conventional memory:
+ *
+ *   0x80000            the stub blob (a few hundred bytes)
+ *   0x81000-0x88000    page tables: PML4 + PDPT + 5 PDs, identity 0-5 GiB
+ *   0x90000            zero page      (LINUX_PARAM_LOC)
+ *   0x91000            command line   (COMMAND_LINE_LOC)
+ *   0x92000            the Linux GDT  (GDT_LOC)
+ *
+ * All of it below the 1 MiB where both the firmware and the kernel live, so
+ * none of it is in the blast radius of the copy.
+ *
+ * THE PAGE TABLES ARE THE PART THAT IS NOT OBVIOUS, and it cost a triple
+ * fault to find. The stub is position-independent, but position-independent
+ * code still runs on a page table, and switch.S puts pml4/pdpt/pd in .bss --
+ * inside the firmware, at 0x184000, which is inside the region the copy
+ * overwrites. The copy therefore demolished the mappings it was itself being
+ * translated through, partway through its own execution.
+ *
+ * The arithmetic is exact and worth keeping, because it is what turned a
+ * silent hang into a one-line diagnosis: writing from 0x100000, the copy
+ * reaches pml4 at 0x184000 after 0x84000 bytes, at which point it is reading
+ * from 0x200000 + 0x84000 = 0x284000. QEMU's -d int reported the page fault
+ * at CR2=0x285000, one page later, at IP=0x80029 -- the `rep movsb` itself.
+ * Then #DF, then the machine was gone.
+ *
+ * So the handoff builds its own identity map down here and switches CR3 to it
+ * before the copy. It maps 0-5 GiB to match what the trampoline in switch.S
+ * maps, rather than the 4 GiB the boot protocol requires, so that nothing the
+ * firmware still touches between here and the jump -- P3 put the NVRAM store
+ * at 0x100000000 -- goes missing at the last moment. */
+#define HANDOFF_LOC    0x80000
+#define HANDOFF_PT_LOC 0x81000
+#define HANDOFF_PT_GIB 5
+
+/* Identity-map 0-5 GiB with 2 MiB pages. 2 MiB rather than 1 GiB pages because
+ * PDPE1GB is a CPUID feature and not every QEMU CPU model has it; seven 4 KiB
+ * pages is a cheap way not to have to ask. */
+static void build_handoff_pagetables(void)
+{
+    uint64_t *pml4 = phys_to_virt(HANDOFF_PT_LOC);
+    uint64_t *pdpt = phys_to_virt(HANDOFF_PT_LOC + 0x1000);
+    uint64_t *pd   = phys_to_virt(HANDOFF_PT_LOC + 0x2000);
+    int g, i;
+
+    memset(pml4, 0, 0x1000);
+    memset(pdpt, 0, 0x1000);
+    pml4[0] = (uint64_t)(HANDOFF_PT_LOC + 0x1000) | 3;		/* P | RW */
+
+    for (g = 0; g < HANDOFF_PT_GIB; g++) {
+	pdpt[g] = (uint64_t)(HANDOFF_PT_LOC + 0x2000 + g * 0x1000) | 3;
+	for (i = 0; i < 512; i++)
+	    pd[g * 512 + i] = (((uint64_t)g << 30) | ((uint64_t)i << 21))
+			      | 0x83;				/* P | RW | PS */
+    }
+}
+
+/* The lgdt operand in 64-bit mode is m16&64: a 2-byte limit and an 8-byte
+ * base. (x86's struct gdtarg has a 4-byte base -- another silent near-miss.) */
+struct gdt64_desc {
+    uint16_t limit;
+    uint64_t base;
+} __attribute__((packed));
+
+/* Not on the C stack: the stack is inside the firmware, and while lgdt happens
+ * before the copy, keeping the descriptor somewhere the copy cannot reach is
+ * one less thing to have to reason about. */
+static struct gdt64_desc handoff_gdt_desc;
+
+static int start_linux(uint32_t kern_run_addr, uint32_t kern_load_addr,
+		       uint32_t kern_size, struct linux_params *params)
+{
+    uint64_t *linux_gdt;
+    handoff_fn stub;
+    uint64_t entry;
+    size_t stub_len;
+
+    /* Four flat descriptors at GDT_LOC. Indices 2 and 3 are the ones the
+     * protocol names; 0 is the mandatory null and 1 is left null so that a
+     * kernel which reloads CS with 0x08 by mistake faults instead of executing
+     * data. GDT_LOC is 0x92000 -- below the kernel, so the copy leaves the
+     * table the far return is about to read through intact. */
+    linux_gdt = phys_to_virt(GDT_LOC);
+    linux_gdt[0] = 0x0000000000000000ULL;	/* null */
+    linux_gdt[1] = 0x0000000000000000ULL;	/* unused */
+    linux_gdt[2] = 0x00AF9A000000FFFFULL;	/* 0x10 __BOOT_CS: 64-bit, L=1 */
+    linux_gdt[3] = 0x00CF92000000FFFFULL;	/* 0x18 __BOOT_DS: flat data */
+
+    handoff_gdt_desc.limit = 4 * 8 - 1;
+    handoff_gdt_desc.base = GDT_LOC;
+
+    /* "the kernel is started by jumping to the 64-bit kernel entry point,
+     * which is the start address of loaded 64-bit kernel plus 0x200." The
+     * entry is relative to where the kernel will RUN, not where it was read
+     * to -- those differ whenever the stub has a copy to do. */
+    entry = (uint64_t)kern_run_addr + 0x200;
+
+    stub_len = (size_t)(linux_handoff_end - linux_handoff);
+    memcpy(phys_to_virt(HANDOFF_LOC), linux_handoff, stub_len);
+    stub = (handoff_fn)(uintptr_t)phys_to_virt(HANDOFF_LOC);
+
+    if (kern_load_addr != kern_run_addr)
+	printf("Moving kernel %#x -> %#x (%#x bytes) and jumping...\n",
+	       kern_load_addr, kern_run_addr, kern_size);
+    else
+	printf("Jumping to entry point...\n");
+
+    debug("rip=%#llx rsi=%#lx stub=%#x+%#lx\n", (unsigned long long)entry,
+	  virt_to_phys(params), HANDOFF_LOC, (unsigned long)stub_len);
+
+#ifdef VGA_CONSOLE
+    /* Update VGA cursor position.
+     * This must be here because the printf changes the value! */
+    params->orig_x = cursor_x;
+    params->orig_y = cursor_y;
+#endif
+
+    /* Off the firmware's page tables before anything overwrites them. Safe to
+     * do here and keep running: the new map is the identity over the same
+     * range, so every address the firmware is using still resolves to itself. */
+    build_handoff_pagetables();
+    asm volatile ("movq %0, %%cr3" : : "r" ((uint64_t)HANDOFF_PT_LOC)
+					: "memory");
+
+    /* Go... A copy length of zero means "already in place"; `rep` with a zero
+     * count is a no-op, so the stub needs no second path for it. */
+    stub(entry, virt_to_phys(params), &handoff_gdt_desc,
+	 kern_load_addr, kern_run_addr,
+	 kern_load_addr == kern_run_addr ? 0 : kern_size);
+
+    /* Not reached. */
+    return 0;
+}
