+#define E820MAX	32		/* number of entries in E820MAP */
+/* THE ZERO PAGE IS AN ABI, AND `unsigned long` IS NOT PART OF IT.
+ *
+ * x86's version of this struct declares `type` as `unsigned long`, which is
+ * 4 bytes on i386 -- so the entry is 8+8+4 = 20 bytes, exactly what the boot
+ * protocol says, and x86 has been right by accident for twenty years. On LP64
+ * `unsigned long` is 8 bytes and the compiler pads the struct to 24. Every
+ * entry after the first then lands 4 bytes late.
+ *
+ * What that looked like: the firmware printed both of its memory ranges and
+ * wrote both into the zero page, and the kernel logged exactly one --
+ *
+ *     BIOS-e820: [mem 0x0000000000000000-0x000000000009fbff] usable
+ *     last_pfn = 0x2018
