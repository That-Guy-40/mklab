+/* ------------------------------------------------------------------
+ * SPIKE 3: the Linux handoff.
+ *
+ *   void linux_handoff(uint64_t entry, uint64_t boot_params, void *gdt_desc,
+ *                      uint64_t src, uint64_t dst, uint64_t len)
+ *          %rdi            %rsi              %rdx        %rcx      %r8    %r9
+ *
+ * THIS BLOB IS COPIED SOMEWHERE ELSE AND RUN FROM THERE, so every instruction
+ * below has to be position-independent. That is not a style preference; it is
+ * the whole reason the blob exists.
+ *
+ * arch/x86 relocates the firmware to the top of RAM, so when it loads a
+ * bzImage to 1 MiB it is writing into free memory. arch/amd64 deliberately
+ * does NOT relocate -- long mode ignores segment bases, so Spike 1 dropped
+ * relocate() as pointless -- and the image is linked at BASE_ADDR = 0x100000.
+ * The firmware therefore LIVES at the address a bzImage must run at, and a
+ * kernel built with CONFIG_RELOCATABLE=n (the showcase payload is exactly
+ * that: relocatable_kernel = 0, verified in the bytes) cannot be asked to move
+ * aside. One of the two has to be overwritten, and by this point the firmware
+ * has no further work to do -- so the copy runs from a stub parked in low
+ * memory, out of both the source and the destination, and the firmware is
+ * demolished underneath it.
+ *
+ * The stack moves too, and forgetting that is the subtle half: %rsp still
+ * points into the firmware's _estack, which is inside the region about to be
+ * overwritten. The `pushq`/`lretq` at the end would then write two words into
+ * the loaded kernel image. So the stub takes its own stack BEFORE it copies.
+ *
+ * The SysV argument registers do part of the work for free: boot_params is the
+ * second argument and so arrives in %rsi, exactly where the 64-bit protocol
+ * wants it. It cannot simply be left there -- `rep movsb` needs %rsi for the
+ * source -- so it is parked in %r11 and put back afterwards. Moving
+ * boot_params to a different argument position would break this silently.
+ */
+	.section .text
+	.code64
+	.globl	linux_handoff, linux_handoff_end
+	.type	linux_handoff, @function
+linux_handoff:
+	cli				/* "interrupt must be disabled" */
+	lgdt	(%rdx)			/* m16&64: 2-byte limit, 8-byte base */
+
+	movw	$0x18, %ax		/* __BOOT_DS */
+	movw	%ax, %ds
+	movw	%ax, %es
+	movw	%ax, %ss
+	movw	%ax, %fs
+	movw	%ax, %gs
+
+	movq	%rdi, %r10		/* entry       (rdi is about to be dst) */
+	movq	%rsi, %r11		/* boot_params (rsi is about to be src) */
+
+	/* Off the firmware stack before a single byte is written -- and onto a
+	 * stack that travels WITH the blob. A fixed address here would have to
+	 * be agreed with linux_load.c, and a constant duplicated across two
+	 * files is a cached fact waiting to go stale. RIP-relative addressing
+	 * is position-independent by construction, so the scratch space at the
+	 * end of this blob is reachable wherever the blob was copied to, with
+	 * nothing to keep in sync. */
+	leaq	handoff_stack_top(%rip), %rsp
+
+	movq	%rcx, %rsi		/* src */
+	movq	%r8,  %rdi		/* dst */
+	movq	%r9,  %rcx		/* len -- zero when no copy is needed,
+					 * and `rep` with %rcx=0 is a no-op, so
+					 * the two cases need no branch */
+	cld				/* forward: dst < src, so an overlap
+					 * still copies correctly */
+	rep	movsb
+
+	/* The firmware no longer exists below this line. */
+
+	movq	%r11, %rsi		/* %rsi = struct boot_params */
+	xorq	%rbp, %rbp
+	xorq	%rbx, %rbx
+	xorq	%rdi, %rdi
+
+	/* Reload CS with __BOOT_CS(0x10). A far JMP in long mode needs an
+	 * m16:64 memory operand -- which would be a reference to this blob's
+	 * own address, the one thing it must not have. A far RETURN takes the
+	 * same pair off the stack instead, and the stack is now ours. */
+	pushq	$0x10
+	pushq	%r10
+	lretq
+
+	/* Two pushes and the far return's pops, with room to spare. Part of the
+	 * blob, so it is copied along with the code and needs no allocation. */
+	.align	16
+	.space	256
+handoff_stack_top:
+linux_handoff_end:
+	.size	linux_handoff, . - linux_handoff
