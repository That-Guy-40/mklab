+    set_memory_size(params, info);
+    initrd_file = parse_command_line(cmdline, phys_to_virt(COMMAND_LINE_LOC));
+    set_command_line_loc(params, &hdr);
+
+    kern_size = load_linux_kernel(&hdr, kern_load_addr);
+    if (kern_size == 0) {
+	if (initrd_file)
+	    free(initrd_file);
+	return -1;
+    }
+
+    if (initrd_file) {
+	/* The initrd has to clear everything the kernel will occupy: the staged
+	 * copy it is read from AND the region it decompresses into once it has
+	 * been moved to kern_addr. init_size (2.10+) is the kernel's own
+	 * statement of that second extent; without it the initrd can land
+	 * inside the area the decompressor is about to expand over, which the
+	 * kernel would report much later as a corrupt initramfs. */
+	uint32_t staged_end = kern_load_addr + kern_size;
+	uint32_t run_end = kern_addr + (hdr.protocol_version >= 0x20a
+					&& hdr.init_size ? hdr.init_size
+							 : kern_size);
+	uint32_t kern_end = staged_end > run_end ? staged_end : run_end;
+
+	if (load_initrd(&hdr, info, kern_end, params, initrd_file)
+		!= 0) {
+	    free(initrd_file);
+	    return -1;
+	}
+	free(initrd_file);
+    }
+
+    /* XLF_KERNEL_64 (bit 0 of xloadflags, protocol 2.12+) is the kernel's own
+     * statement that the +0x200 entry exists. Refusing here by name beats
+     * jumping into a 32-bit-only image and letting the fault handler describe
+     * the wreckage -- and it is a real possibility, since this loader still
+     * accepts the zImage and Image formats that predate the flag entirely. */
+    if (hdr.protocol_version < 0x20c || !(hdr.xloadflags & 1)) {
+	printf("This kernel has no 64-bit entry point "
+	       "(protocol %d.%02d, xloadflags %#x).\n",
+	       hdr.protocol_version >> 8, hdr.protocol_version & 0xff,
+	       hdr.xloadflags);
+	printf("The amd64 firmware cannot drop back to the 32-bit entry.\n");
+	return LOADER_NOT_SUPPORT;
+    }
+
+    hardware_setup();
+
+    start_linux(kern_addr, kern_load_addr, kern_size, params);
+    return 0;
 }
