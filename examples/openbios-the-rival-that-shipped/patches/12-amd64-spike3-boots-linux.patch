+/* Top of usable RAM below 4 GiB. Pulled out of set_memory_size() because
+ * load_initrd() needs the same number and computing it twice is how the two
+ * answers drift apart. */
+static uint32_t ram_top(struct sys_info *info)
+{
+    uint32_t ramtop = 0;
+    int i;
+
+    for (i = 0; i < info->n_memranges; i++) {
+	uint64_t end = info->memrange[i].base + info->memrange[i].size;
+
+	if (end < (1ULL << 32) && (uint32_t)end > ramtop)
+	    ramtop = (uint32_t)end;
+    }
+    return ramtop;
+}
+
+/* Memory map */
+static void
+set_memory_size(struct linux_params *params, struct sys_info *info)
+{
+    int i;
+    uint32_t ramtop = ram_top(info);
+    struct e820entry *linux_map;
+    struct memrange *filo_map;
+
+    linux_map = params->e820_map;
+    filo_map = info->memrange;
+    for (i = 0; i < info->n_memranges; i++, linux_map++, filo_map++) {
+	if (i < E820MAX) {
+	    /* Convert to BIOS e820 style */
+	    linux_map->addr = filo_map->base;
+	    linux_map->size = filo_map->size;
+	    linux_map->type = E820_RAM;
+	    /* Cast at the call site: uint64_t is `unsigned long` on LP64, so
+	     * %Lx is a type mismatch here even though the value is right. */
+	    debug("%016Lx - %016Lx\n",
+		    (unsigned long long)linux_map->addr,
+		    (unsigned long long)(linux_map->addr + linux_map->size));
+	    params->e820_map_nr = i+1;
+	}
+
+    }
+    debug("ramtop=%#x\n", ramtop);
+    /* Size of memory above 1MB in KB */
+    params->alt_mem_k = (ramtop - (1<<20)) >> 10;
+    /* old style, 64MB max */
+    if (ramtop >= (64<<20))
+	params->ext_mem_k = (63<<10);
+    else
+	params->ext_mem_k = params->alt_mem_k;
+    debug("ext_mem_k=%d, alt_mem_k=%d\n", params->ext_mem_k, params->alt_mem_k);
+}
