+
+/* THE OFFSETS ARE THE CONTRACT, so let the compiler check them.
+ *
+ * Every field above carries its zero-page offset in a comment, and comments do
+ * not fail a build. The e820 bug proved that: the struct silently grew by four
+ * bytes per entry on LP64, every offset comment stayed "right", and the only
+ * symptom was a kernel that thought it had 640 KiB and then died where nobody
+ * could hear it.
+ *
+ * A negative array size rather than _Static_assert, because this tree is built
+ * as gnu89 and has to keep compiling for the 32-bit arches too. If one of these
+ * ever stops holding, the build stops -- which is the whole point, since the
+ * runtime symptom is silence. */
+/* This is a freestanding build: there is no <stddef.h> on the include path, so
+ * offsetof has to come from the compiler rather than the C library. */
+#ifndef offsetof
+#define offsetof(TYPE, MEMBER) __builtin_offsetof(TYPE, MEMBER)
+#endif
+
+#define LINUX_ABI_ASSERT(name, cond) \
+	typedef char linux_abi_##name[(cond) ? 1 : -1]
+
+LINUX_ABI_ASSERT(e820entry_is_20_bytes,  sizeof(struct e820entry) == 20);
+LINUX_ABI_ASSERT(zero_page_is_a_page,    sizeof(struct linux_params) == 4096);
+LINUX_ABI_ASSERT(e820_map_nr_at_1e8,
+		 offsetof(struct linux_params, e820_map_nr) == 0x1e8);
+LINUX_ABI_ASSERT(e820_map_at_2d0,
+		 offsetof(struct linux_params, e820_map) == 0x2d0);
+/* 0x1f1 is where init_linux_params() starts its copy of the setup header --
+ * one past the sentinel at 0x1ef, which must stay zero. */
+LINUX_ABI_ASSERT(setup_hdr_copy_starts_at_1f1,
+		 offsetof(struct linux_params, reserved6) + 8 == 0x1f1);
+LINUX_ABI_ASSERT(cmd_line_ptr_at_228,
+		 offsetof(struct linux_params, cmd_line_ptr) == 0x228);
+LINUX_ABI_ASSERT(hdr_xloadflags_at_236,
+		 offsetof(struct linux_header, xloadflags) == 0x236);
+LINUX_ABI_ASSERT(hdr_relocatable_at_234,
+		 offsetof(struct linux_header, relocatable_kernel) == 0x234);
+
+
+static uint64_t forced_memsize;
+/* The firmware extent comes from arch/amd64/ldscript. It is already declared
+ * by include/arch/amd64/io.h as `extern char _start, _end` -- scalars, not
+ * arrays -- so the addresses are taken with &. Re-declaring them here as
+ * char[] (the spelling arch/x86/linux_load.c uses inside load_initrd) is a
+ * conflicting type and does not compile. */
+static int fd;
+
+static unsigned long file_size(void)
+{
+	long long fpos, fsize;
+
+	/* Save current position */
+	fpos = tell(fd);
+
+	/* Go to end of file and get position */
+	seek_io(fd, -1);
+	fsize = tell(fd);
+
+	/* Go back to old position */
+	seek_io(fd, 0);
+	seek_io(fd, fpos);
+
+	return fsize;
+}
+
+/* Load the first part the file and check if it's Linux */
+static uint32_t load_linux_header(struct linux_header *hdr)
+{
+    int load_high;
+    uint32_t kern_addr;
+
+    if (read_io(fd, hdr, sizeof *hdr) != sizeof *hdr) {
+	debug("Can't read Linux header\n");
+	return 0;
+    }
+    if (hdr->boot_sector_magic != 0xaa55) {
+	debug("Not a Linux kernel image\n");
+	return 0;
+    }
+
+    /* Linux is found. Print some information */
+    if (memcmp(hdr->header_magic, "HdrS", 4) != 0) {
+	/* This may be floppy disk image or something.
+	 * Perform a simple (incomplete) sanity check. */
+	if (hdr->setup_sects >= 16
+		|| file_size() - (hdr->setup_sects<<9) >= 512<<10) {
+	    debug("This looks like a bootdisk image but not like Linux...\n");
+	    return 0;
+	}
+
+	printf("Possible very old Linux");
+	/* This kernel does not even have a protocol version.
+	 * Force the value. */
+	hdr->protocol_version = 0; /* pre-2.00 */
+    } else
+	printf("Found Linux");
+    if (hdr->protocol_version >= 0x200 && hdr->kver_addr) {
+	char kver[256];
+	seek_io(fd, hdr->kver_addr + 0x200);
+	if (read_io(fd, kver, sizeof kver) != 0) {
+	    kver[255] = 0;
+	    printf(" version %s", kver);
+	}
+    }
+    debug(" (protocol %#x)", hdr->protocol_version);
+    load_high = 0;
+    if (hdr->protocol_version >= 0x200) {
+	debug(" (loadflags %#x)", hdr->loadflags);
+	load_high = hdr->loadflags & 1;
+    }
+    if (load_high) {
+	printf(" bzImage");
+	kern_addr = 0x100000;
+    } else {
+	printf(" zImage or Image");
+	kern_addr = 0x1000;
+    }
+    printf(".\n");
+
+    return kern_addr;
+}
+
+/* Set up parameters for 32-bit kernel */
+static void
+init_linux_params(struct linux_params *params, struct linux_header *hdr)
+{
+    debug("Setting up parameters at %#lx\n", virt_to_phys(params));
+    memset(params, 0, sizeof *params);
+
+    /* Boot protocol 2.02+: the loader must copy the ENTIRE setup header
+     * into the zero page at 0x1f1 — modern kernels read fields this 2003
+     * loader never knew (kernel_alignment, init_size, pref_address...);
+     * leaving them zero sent the decompression stub's relocation math to
+     * a >4 GB stack (page fault in startup_64 before the first printk).
+     * Loader-owned fields are overwritten again below/later. */
+    memcpy((uint8_t *)params + 0x1f1, (uint8_t *)hdr + 0x1f1,
+           sizeof(*hdr) - 0x1f1);
+
+    /* Copy some useful values from header */
+    params->mount_root_rdonly = hdr->root_flags;
+    params->orig_root_dev = hdr->root_dev;
+
+    /* Video parameters.
+     * This assumes we have VGA in standard 80x25 text mode,
+     * just like our vga.c does.
+     * Cursor position is filled later to allow some more printf's. */
+    params->orig_video_mode = 3;
+    params->orig_video_cols = 80;
+    params->orig_video_lines = 25;
+    params->orig_video_isVGA = 1;
+    params->orig_video_points = 16;
