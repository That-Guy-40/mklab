+ * -- because entry 0 still decoded (the low half of the 8-byte `type` reads as
+ * the right u32 on a little-endian machine) and entry 1 was read from the
+ * middle of ours. A 512 MiB machine became a 640 KiB one, and the kernel then
+ * died in init_mem_mapping with "alloc_low_pages: can not alloc memory",
+ * BEFORE console_init -- so the panic went into the printk ring buffer and
+ * never to a console. Total silence, from a kernel that was running fine.
+ *
+ * Fixed-width types and `packed`, so the layout is the protocol's rather than
+ * the ABI's. */
+struct e820entry {
+	uint64_t addr;			/* start of memory segment */
+	uint64_t size;			/* size of memory segment */
+	uint32_t type;			/* type of memory segment */
+#define E820_RAM	1
+#define E820_RESERVED	2
+#define E820_ACPI	3 /* usable as RAM once ACPI tables have been read */
+#define E820_NVS	4
+} __attribute__((packed));
