+/* tag: amd64 exception handling  (Spike 2)
+ *
+ * arch/x86 has had an exception.c since 2004; arch/amd64 never did -- the
+ * census recorded it as "still to author from scratch". This is the 64-bit
+ * counterpart, and it keeps the behaviour that makes x86's version useful:
+ * it does NOT halt. It names the fault, dumps the machine and the Forth
+ * engine's state, resets the stacks, and returns into the outer interpreter,
+ * so a mistake at the prompt costs you a message rather than the session.
+ *
+ * See the file "COPYING" for further information about
+ * the copyright and warranty status of this work.
+ */
+
+#include "config.h"
+#include "libopenbios/bindings.h"
+#include "asm/types.h"
+
+/* program counter */
+extern ucell            PC;
+
+extern unsigned char    *dict;
+extern cell             dicthead;
+extern ucell            *last;
+
+/* THE LAYOUT IS THE CONTRACT with the stubs in switch.S: fields ascend in the
+ * order the pushes leave them in memory. Getting it wrong here does not fail
+ * to compile -- it prints a plausible register dump full of the wrong values,
+ * which is worse than no dump at all. */
+struct eregs {
+	uint64_t r15, r14, r13, r12, r11, r10, r9, r8;
+	uint64_t rdi, rsi, rbp, rbx, rdx, rcx, rax;
+	uint64_t vector;
+	uint64_t error_code;
+	/* pushed by the CPU */
+	uint64_t rip;
+	uint64_t cs;
+	uint64_t rflags;
+	uint64_t rsp;
+	uint64_t ss;
+};
+
+static const char * const exception_names[] = {
+	"division by zero",
+	"single step",
+	"NMI",
+	"breakpoint",
+	"interrupt overflow",
+	"bound range exceeded",
+	"invalid opcode",
+	"device unavailable",
+	"double fault",
+	"FPU segment overrun",
+	"invalid TSS",
+	"segment not present",
+	"stack exception",
+	"general protection fault",
+	"page fault",
+	"reserved",
+	"floating point exception",
+	"alignment check",
+	"machine check exception",
+};
+
+void do_nothing(void);
+void do_nothing(void)
+{
+}
+
+void amd64_exception(struct eregs *info);
+void amd64_exception(struct eregs *info)
+{
+	uint64_t cr2 = 0;
+
+	if (info->vector <= 18)
+		printk("\nUnexpected Exception: %s", exception_names[info->vector]);
+	else
+		printk("\nUnexpected Exception: %d", (int)info->vector);
+
+	printk(" @ %02x:%016lx\n", (unsigned)info->cs, (unsigned long)info->rip);
+	printk("Code: %d  rflags: %016lx\n",
+	       (int)info->error_code, (unsigned long)info->rflags);
+
+	/* A page fault's faulting ADDRESS is the whole story, and it lives in
+	 * CR2 rather than on the stack. Printing the frame without it would
+	 * name the fault and hide what caused it. */
+	if (info->vector == 14) {
+		asm volatile ("movq %%cr2, %0" : "=r" (cr2));
+		printk("Faulting address: %016lx\n", (unsigned long)cr2);
+	}
+
+	printk("rax: %016lx rbx: %016lx rcx: %016lx rdx: %016lx\n",
+	       (unsigned long)info->rax, (unsigned long)info->rbx,
+	       (unsigned long)info->rcx, (unsigned long)info->rdx);
+	printk("rsi: %016lx rdi: %016lx rbp: %016lx rsp: %016lx\n",
+	       (unsigned long)info->rsi, (unsigned long)info->rdi,
+	       (unsigned long)info->rbp, (unsigned long)info->rsp);
+
+	printk("\ndict=0x%lx here=0x%lx(dict+0x%lx) pc=0x%lx(dict+0x%lx)\n",
+	       (unsigned long)(ucell)dict, (unsigned long)((ucell)dict + dicthead),
+	       (unsigned long)dicthead, (unsigned long)PC,
+	       (unsigned long)(PC - (ucell)dict));
+	printk("dstackcnt=%d rstackcnt=%d\n", dstackcnt, rstackcnt);
+
+	/* RECOVERY IS ONLY HONEST IF THERE IS SOMETHING TO RECOVER INTO.
+	 * If the dictionary is not loaded yet, findword() searches a NULL dict
+	 * and the "recovered" machine faults again immediately at rip=0 -- an
+	 * infinite fault loop that buries the ORIGINAL message under a hundred
+	 * copies of a later one. Measured while building this. Halt instead:
+	 * a fault before the interpreter exists is not survivable, and saying
+	 * so once is worth more than pretending a hundred times. */
+	if (!dict) {
+		printk("\nFault before the dictionary was loaded -- halting.\n");
+		for (;;)
+			asm volatile ("cli; hlt");
+	}
+
+	/* Recover rather than halt, exactly as arch/x86 does: empty the Forth
+	 * stacks, aim the interpreter at its outer loop, and return through a
+	 * function that does nothing. iretq then resumes there instead of at
+	 * the instruction that faulted. */
+	rstackcnt = 0;
+	dstackcnt = 0;
+
+	/* + sizeof(ucell), which arch/x86's copy of this line OMITS.
+	 * findword() returns the word's HEADER; the interpreter has to be
+	 * entered at its BODY, one cell along. kernel/forth.c:686 -- the
+	 * engine's own "start a subordinate interpreter" path -- gets this
+	 * right: `PC = findword("outer-interpreter") + sizeof(ucell)`.
+	 * Without the offset the machine survives the fault, prints " ok",
+	 * and then accepts no further input: alive, and not listening. */
+	PC = findword("outer-interpreter") + sizeof(ucell);
+
+	info->rip = (uint64_t)&do_nothing;
+}
