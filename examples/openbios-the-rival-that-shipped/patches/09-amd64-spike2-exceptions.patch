# patches/09-amd64-spike2-exceptions.patch — SPIKE 2, first half: a 64-bit IDT.
#
# Applies on top of 08-amd64-spike1-trampoline.patch.
#
# Verified by: ./smoke-openbios.sh amd64-fault
#   0 > 0 100000000 !
#   Unexpected Exception: page fault @ 08:...
#   Faulting address: 0000000100000000
#
# arch/amd64 had NO exception.c and NO IDT: the first fault was a triple fault
# and the machine vanished -- which is exactly how Spike 1's SSE bug presented.
#
# A 64-bit gate is SIXTEEN bytes, not eight, with the handler offset split over
# three fields, so init_exceptions is new code rather than a port of x86's.
#
# THE NULL TRAP WAS BUILT AND GIVEN BACK. Mapping the low 2 MiB as 4 KiB pages
# with page 0 absent makes `0 0 !` fault -- and makes the firmware fault during
# BOOT, because the console reads the VGA CRTC port address out of the BIOS
# Data Area at 0x400-0x463, which is inside page 0. Page zero is not spare on a
# PC. The checkpoint faults above 4 GiB instead, which a 32-bit firmware cannot
# even address.
#
# KNOWN LIMIT: the machine survives the fault and prints " ok", but the outer
# interpreter accepts no further input. The recovery design is inherited from
# arch/x86/exception.c, whose own version omits the `+ sizeof(ucell)` that
# kernel/forth.c:686 keeps -- and which has probably never been exercised,
# since arch/x86 runs unpaged and a stray write there simply lands.

diff --git a/arch/amd64/build.xml b/arch/amd64/build.xml
index 8f436d0..a914cb2 100644
--- a/arch/amd64/build.xml
+++ b/arch/amd64/build.xml
@@ -1,6 +1,38 @@
 <build condition="AMD64">
+
  <dictionary name="openbios-amd64" init="openbios" target="forth">
   <object source="init.fs"/>
   <object source="QEMU,VGA.bin" target="fcode" condition="DRIVER_VGA" />
  </dictionary>
+
+ <library name="amd64" type="static" target="target">
+  <object source="openbios.c"/>
+  <object source="console.c"/>
+  <object source="lib.c"/>
+  <object source="boot.c"/>
+  <object source="context.c"/>
+  <object source="exception.c"/>
+  <object source="linux_load.c"/>
+  <object source="segment.c"/>
+  <object source="sys_info.c"/>
+  <object source="switch.S"/>
+ </library>
+
+ <executable name="openbios.multiboot" target="target" condition="IMAGE_ELF_MULTIBOOT">
+  <rule>
+	$(call quiet-command,$(LD) --warn-common -N -T $(SRCDIR)/arch/amd64/ldscript -o $@.nostrip --whole-archive $^,"  LINK  $(TARGET_DIR)$@")
+	$(call quiet-command,$(NM) $@.nostrip | sort > $(ODIR)/openbios-multiboot.syms,"  GEN   $(TARGET_DIR)$@.syms")
+	$(call quiet-command,$(STRIP) $@.nostrip -o $@,"  STRIP $(TARGET_DIR)$@")
+	$(call quiet-command,$(OBJCOPY) -I elf64-x86-64 -O elf32-i386 $@ $@32,"  ELF32 $(TARGET_DIR)$@32")</rule>
+  <object source="multiboot.c"/>
+  <external-object source="libamd64.a"/>
+  <external-object source="libbootstrap.a"/>
+  <external-object source="libopenbios.a"/>
+  <external-object source="libpackages.a"/>
+  <external-object source="libdrivers.a"/>
+  <external-object source="liblibc.a"/>
+  <external-object source="libfs.a"/>
+  <external-object source="libgcc.a"/>
+ </executable>
+
 </build>
