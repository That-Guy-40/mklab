+/* ------------------------------------------------------------------ *
+ * Spike 2: a self-test of the switch, bound as the Forth word
+ * `test-ctx-switch`.
+ *
+ * The checkpoint is "the client-program context still switches back to the
+ * prompt", and proving that normally needs a client ELF -- which is Spike 3's
+ * work. This exercises THE SAME MACHINERY a client uses: init_context builds a
+ * frame on a fresh stack, arch_init_program's entry field is set by hand, and
+ * switch_to() runs it. The callee sets a flag and returns, which lands on
+ * __exit_context and switches back.
+ *
+ * It returns the flag rather than printing it, so the Forth side decides what
+ * a pass looks like -- and a switch that never came back cannot fake it: the
+ * word simply never returns, and the prompt never comes.
+ * ------------------------------------------------------------------ */
+static volatile int ctx_test_flag;
+static uint8_t ctx_test_stack[8192];
+
+static void ctx_test_body(void)
+{
+    ctx_test_flag = 0x5A;
+    /* returning lands on __exit_context, planted by init_context */
+}
+
+int context_self_test(void)
+{
+    struct context *ctx;
+
+    ctx_test_flag = 0;
+
+    ctx = init_context(ctx_test_stack, sizeof(ctx_test_stack), 0);
+    ctx->rip = (uint64_t) ctx_test_body;
+
+    switch_to(ctx);
+
+    return ctx_test_flag;
+}
