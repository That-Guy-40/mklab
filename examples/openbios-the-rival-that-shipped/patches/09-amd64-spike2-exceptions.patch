-/* Spike 2 owns these. Halting is the honest stub: returning would hand
- * control back with none of the state a switch is supposed to have restored. */
+/* ------------------------------------------------------------------ *
+ * Spike 2: the context switch.
+ *
+ * THE FRAME IS THE STACK. Push everything, hand the stack pointer to
+ * __context, take whatever __context was holding, and pop. The pointer swap
+ * IS the switch; there is no copying and no second stack.
+ *
+ * Called with `call`, so the return address is already on the stack and
+ * becomes the frame's `rip`. The push order below is the field order of
+ * struct context, ascending -- r15 last, so it lands lowest.
+ *
+ * No lretq and no segment pushes, unlike the 32-bit original: CS and SS never
+ * change here (one flat GDT, no relocation), and `push %ds` does not encode in
+ * long mode anyway. No xmm saves either -- SysV makes them caller-saved, and
+ * this is reached by a call.
+ * ------------------------------------------------------------------ */
 __switch_context:
+	pushfq
+	pushq	%rax
+	pushq	%rcx
+	pushq	%rdx
+	pushq	%rbx
+	pushq	%rbp
+	pushq	%rsi
+	pushq	%rdi
+	pushq	%r8
+	pushq	%r9
+	pushq	%r10
+	pushq	%r11
+	pushq	%r12
+	pushq	%r13
+	pushq	%r14
+	pushq	%r15
+
+	cli
+
+	/* Swap our frame pointer with the one in __context. */
+	movq	%rsp, %rax
+	xchgq	%rax, __context(%rip)
+	movq	%rax, %rsp
+
+	popq	%r15
+	popq	%r14
+	popq	%r13
+	popq	%r12
+	popq	%r11
+	popq	%r10
+	popq	%r9
+	popq	%r8
+	popq	%rdi
+	popq	%rsi
+	popq	%rbp
+	popq	%rbx
+	popq	%rdx
+	popq	%rcx
+	popq	%rax
+	popfq
+
+	/* Straight into the new context: for a resumed one this returns to its
+	 * own call site, and for a fresh one it enters at the rip that
+	 * init_context/arch_init_program planted. */
+	ret
+
+/* A client that runs off the end of its program returns HERE, because
+ * init_context put this address above its entry point. Switch back to
+ * whoever started it. */
 __exit_context:
+	call	__switch_context
+
+	/* Reached only if something switches INTO a context that has already
+	 * exited. There is nothing sensible to do with that. */
 	jmp	halt
 
+/* ------------------------------------------------------------------ *
+ * Spike 2: exceptions.
+ *
+ * arch/x86 builds its IDT in entry.S, which amd64 has never had. A 64-bit gate
+ * is SIXTEEN bytes, not eight, and the offset is split across three fields --
+ * an IDT built with the 32-bit routine would look plausible and dispatch every
+ * vector to garbage.
+ * ------------------------------------------------------------------ */
+	.code64
+init_exceptions:
+	pushq	%rbx
+	pushq	%rdi
+
+	leaq	_idt(%rip), %rdi
+	leaq	vec0(%rip), %rbx
+	movl	$32, %ecx		/* vectors 0..31 */
+
+1:	movq	%rbx, %rax
+	movw	%ax, 0(%rdi)		/* offset 15:0   */
+	movw	$0x08, 2(%rdi)		/* selector      */
+	movb	$0, 4(%rdi)		/* IST = 0       */
+	movb	$0x8E, 5(%rdi)		/* present, DPL0, 64-bit interrupt gate */
+	shrq	$16, %rax
+	movw	%ax, 6(%rdi)		/* offset 31:16  */
+	shrq	$16, %rax
+	movl	%eax, 8(%rdi)		/* offset 63:32  */
+	movl	$0, 12(%rdi)		/* reserved      */
+
+	addq	$VECSTUB_SIZE, %rbx
+	addq	$16, %rdi
+	loop	1b
+
+	lidt	idtarg(%rip)
+
+	xorl	%eax, %eax
+	popq	%rdi
+	popq	%rbx
+	ret
+
+/* Each stub is padded to a FIXED SIZE so init_exceptions can walk them with
+ * one add. The CPU pushes an error code for some vectors and not others, so
+ * the ones without push a zero: the frame the C handler reads has to be the
+ * same shape for every vector. */
+	/* .set, not #define: this file is handed to the assembler directly,
+	 * with no C preprocessor in between -- a #define here links as an
+	 * UNDEFINED SYMBOL rather than failing to compile. */
+	.set	VECSTUB_SIZE, 16
+
+.macro VEC_NOERR num
+	.align	VECSTUB_SIZE
+	pushq	$0
+	pushq	$\num
+	jmp	int_hand
+.endm
+
+.macro VEC_ERR num
+	.align	VECSTUB_SIZE
+	nop			/* keep the stub the same length as VEC_NOERR */
+	nop
+	pushq	$\num
+	jmp	int_hand
+.endm
+
+	.align	VECSTUB_SIZE
+vec0:	VEC_NOERR 0
+	VEC_NOERR 1
+	VEC_NOERR 2
+	VEC_NOERR 3
+	VEC_NOERR 4
+	VEC_NOERR 5
+	VEC_NOERR 6
+	VEC_NOERR 7
+	VEC_ERR   8
+	VEC_NOERR 9
+	VEC_ERR   10
+	VEC_ERR   11
+	VEC_ERR   12
+	VEC_ERR   13
+	VEC_ERR   14
+	VEC_NOERR 15
+	VEC_NOERR 16
+	VEC_ERR   17
+	VEC_NOERR 18
+	VEC_NOERR 19
+	VEC_NOERR 20
+	VEC_ERR   21
+	VEC_NOERR 22
+	VEC_NOERR 23
+	VEC_NOERR 24
+	VEC_NOERR 25
+	VEC_NOERR 26
+	VEC_NOERR 27
+	VEC_NOERR 28
+	VEC_NOERR 29
+	VEC_NOERR 30
+	VEC_NOERR 31
+
+int_hand:
+	/* On entry the stack holds, from %rsp up:
+	 *   vector, error_code, rip, cs, rflags, rsp, ss
+	 * Push the GPRs so the whole thing matches struct eregs. */
+	pushq	%rax
+	pushq	%rcx
+	pushq	%rdx
+	pushq	%rbx
+	pushq	%rbp
+	pushq	%rsi
+	pushq	%rdi
+	pushq	%r8
+	pushq	%r9
+	pushq	%r10
+	pushq	%r11
+	pushq	%r12
+	pushq	%r13
+	pushq	%r14
+	pushq	%r15
+
+	movq	%rsp, %rdi		/* SysV: first argument */
+	call	amd64_exception
+
+	popq	%r15
+	popq	%r14
+	popq	%r13
+	popq	%r12
+	popq	%r11
+	popq	%r10
+	popq	%r9
+	popq	%r8
+	popq	%rdi
+	popq	%rsi
+	popq	%rbp
+	popq	%rbx
+	popq	%rdx
+	popq	%rcx
+	popq	%rax
+
+	addq	$16, %rsp		/* drop vector and error code */
+	iretq
+
+	.section .data
+	.align	16
+idtarg:
+	.word	_idt_end - _idt - 1	/* limit: 2 bytes */
+	.quad	_idt			/* base:  EIGHT bytes in long mode */
+
+	.align	16
+_idt:
+	.space	32 * 16			/* 32 gates, 16 bytes each */
+_idt_end:
