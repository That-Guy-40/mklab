From: mklab <noreply@example.invalid>
Subject: [PATCH 36/36] amd64 had no IMAGE_ELF_EMBEDDED rules, so builtin-amd64 built nothing and exited 0

arch/amd64/build.xml declared exactly ONE executable, openbios.multiboot, so
`switch-arch builtin-amd64` set CONFIG_IMAGE_ELF_EMBEDDED and the build then
produced nothing extra and exited 0 -- a silent no-op, the same shape as the
missing multiboot rule Tier B found.

coreboot cannot hand a payload a separate dictionary module the way QEMU's
-kernel/-initrd can, so the coreboot image is necessarily the EMBEDDED one:
the dictionary is compiled in. This adds the three executables arch/x86 has
for that (static-dict.h, builtin.o, openbios-builtin.elf), reusing the
ELF64->ELF32 objcopy the multiboot rule beside it already carries, since
coreboot enters a payload in 32-bit protected mode.

Arch-tested: amd64

diff --git a/arch/amd64/build.xml b/arch/amd64/build.xml
--- a/arch/amd64/build.xml
+++ b/arch/amd64/build.xml
@@ -35,4 +35,40 @@
   <external-object source="libgcc.a"/>
  </executable>
 
+ <!-- SPIKE: the IMAGE_ELF_EMBEDDED set, mirroring arch/x86/build.xml. coreboot has
+      no way to hand a payload a separate dictionary module the way -kernel/-initrd
+      does, so the coreboot image is the one with the dictionary compiled IN. -->
+
+ <!-- HACK ALERT -->
+
+ <executable name="target/include/static-dict.h" target="target" condition="IMAGE_ELF_EMBEDDED">
+  <rule><![CDATA[
+	$(call quiet-command,$(ODIR)/forthstrap -x -D $@ -d $< </dev/null, "  GEN   $(TARGET_DIR)$@")]]></rule>
+  <external-object source="openbios-amd64.dict"/>
+ </executable>
+
+ <executable name="target/arch/amd64/builtin.o" target="target" condition="IMAGE_ELF_EMBEDDED">
+  <rule><![CDATA[ $(SRCDIR)/arch/amd64/builtin.c $(ODIR)/target/include/static-dict.h
+	$(call quiet-command,$(CC) $$EXTRACFLAGS $(CFLAGS) $(INCLUDES) -c -o $@ $(SRCDIR)/arch/amd64/builtin.c, "  CC    $(TARGET_DIR)$@")]]></rule>
+ </executable>
+
+ <!-- END OF HACK ALERT -->
+
+ <executable name="openbios-builtin.elf" target="target" condition="IMAGE_ELF_EMBEDDED">
+  <rule>
+	$(call quiet-command,$(LD) --warn-common -N -T $(SRCDIR)/arch/amd64/ldscript -o $@.nostrip --whole-archive $^,"  LINK  $(TARGET_DIR)$@")
+	$(call quiet-command,$(NM) $@.nostrip | sort > $(ODIR)/openbios-builtin.syms,"  GEN   $(TARGET_DIR)$@.syms")
+	$(call quiet-command,$(STRIP) $@.nostrip -o $@,"  STRIP $(TARGET_DIR)$@")
+	$(call quiet-command,$(OBJCOPY) -I elf64-x86-64 -O elf32-i386 $@ $@32,"  ELF32 $(TARGET_DIR)$@32")</rule>
+  <external-object source="target/arch/amd64/builtin.o"/>
+  <external-object source="libamd64.a"/>
+  <external-object source="libbootstrap.a"/>
+  <external-object source="libopenbios.a"/>
+  <external-object source="libpackages.a"/>
+  <external-object source="libdrivers.a"/>
+  <external-object source="liblibc.a"/>
+  <external-object source="libfs.a"/>
+  <external-object source="libgcc.a"/>
+ </executable>
+
 </build>
