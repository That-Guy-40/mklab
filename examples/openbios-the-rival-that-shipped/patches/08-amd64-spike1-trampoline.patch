diff --git a/arch/amd64/context.c b/arch/amd64/context.c
index dff9975..385acfe 100644
--- a/arch/amd64/context.c
+++ b/arch/amd64/context.c
@@ -9,13 +9,19 @@
 #include "libopenbios/initprogram.h"
 #include "segment.h"
 #include "context.h"
+#include "openbios.h"   /* Spike 1: for openbios(), which was a nested extern */
+
+/* Spike 1: stashed by the trampoline in switch.S before it clobbers them. */
+extern uint64_t mb_magic, mb_info;
 
 #define MAIN_STACK_SIZE 16384
 #define IMAGE_STACK_SIZE 4096
 
 #define debug printk
 
-static void start_main(void); /* forward decl. */
+/* Spike 1: no longer static -- the trampoline in switch.S calls it directly,
+ * because the context-switch path that used to reach it is Spike 2's work. */
+void start_main(void); /* forward decl. */
 void __exit_context(void); /* assembly routine */
 
 /*
@@ -32,14 +38,14 @@ struct context main_ctx __attribute__((section (".initctx"))) = {
     .fs = FLAT_DS,
     .gs = FLAT_DS,
     .ss = FLAT_DS,
-    .esp = (uint32_t) ESP_LOC(&main_ctx),
-    .eip = (uint32_t) start_main,
-    .return_addr = (uint32_t) __exit_context,
+    .rsp = (uint64_t) ESP_LOC(&main_ctx),
+    .rip = (uint64_t) start_main,
+    .return_addr = (uint64_t) __exit_context,
 };
 
 /* This is used by assembly routine to load/store the context which
  * it is to switch/switched.  */
-struct context *__context = &main_ctx;
+struct context * volatile __context = &main_ctx;   /* Spike 1 drift: volatile, as arch/x86 has */
 
 /* Client program context */
 static struct context *client_ctx;
@@ -54,13 +60,19 @@ unsigned long __boot_ctx;
  * Main starter
  * This is the C function that runs first.
  */
-static void start_main(void)
+void start_main(void)
 {
     int retval;
-    extern int openbios(void);
+    /* Spike 1 drift: the nested extern is gone; openbios() is declared in
+     * arch/amd64/openbios.h, exactly as the x86 twin arranges it. */
+
+    /* Spike 1: put the loader's handoff where sys_info.c reads it from.
+     * The trampoline stashed %eax/%ebx before it clobbered them building page
+     * tables; the frame they used to be pushed into did not exist yet. */
+    __context->rax = mb_magic;
+    __context->rbx = mb_info;
 
-    /* Save startup context, so we can refer to it later.
-     * We have to keep it in physical address since we will relocate. */
+    /* Save startup context, so we can refer to it later. */
     __boot_ctx = virt_to_phys(__context);
 
     /* Set up client context */
@@ -71,7 +83,7 @@ static void start_main(void)
     retval = openbios();
 
     /* Pass return value to startup context. Bootloader may see it. */
-    boot_ctx->eax = retval;
+    boot_ctx->rax = retval;
 
     /* Returning from here should jump to __exit_context */
     __context = boot_ctx;
@@ -80,12 +92,12 @@ static void start_main(void)
 /* Setup a new context using the given stack.
  */
 struct context *
-init_context(uint8_t *stack, uint32_t stack_size, int num_params)
+init_context(uint8_t *stack, uint64_t stack_size, int num_params)
 {
     struct context *ctx;
 
     ctx = (struct context *)
-	(stack + stack_size - (sizeof(*ctx) + num_params*sizeof(uint32_t)));
+	(stack + stack_size - (sizeof(*ctx) + num_params*sizeof(ucell)));
     memset(ctx, 0, sizeof(*ctx));
 
     return ctx;
@@ -107,7 +119,7 @@ arch_init_program(void)
     ctx->fs = FLAT_DS;
     ctx->gs = FLAT_DS;
     ctx->ss = FLAT_DS;
-    ctx->esp = virt_to_phys(ESP_LOC(ctx));
+    ctx->rsp = virt_to_phys(ESP_LOC(ctx));
     ctx->return_addr = virt_to_phys(__exit_context);
     
     /* Set param */
@@ -119,14 +131,14 @@ arch_init_program(void)
     feval("load-state >ls.file-type @");
     type = POP();
     if (type == 0) {
-        ctx->eax = 0xe1fb007;
-        ctx->ebx = param;
+        ctx->rax = 0xe1fb007;
+        ctx->rbx = param;
     }
 
     /* Set entry point */
     feval("load-state >ls.entry @");
     entry = POP();
-    ctx->eip = entry;
+    ctx->rip = entry;
 
     return 0;
 }
@@ -140,7 +152,13 @@ struct context *switch_to(struct context *ctx)
     debug("switching to new context:\n");
     save = __context;
     __context = ctx;
-    asm ("pushl %cs; call __switch_context");
+    /* Spike 1: `pushl %cs` does not assemble in long mode, and the routine it
+     * called is stubbed in switch.S -- context switching is Spike 2's work.
+     * Calling the stub is deliberate: it HALTS, loudly, instead of returning
+     * here as though a switch had happened. A silent no-op would let the
+     * caller carry on with a client program's context half-installed, which is
+     * a far worse failure than stopping. */
+    asm volatile ("call __switch_context");
     ret = __context;
     __context = (struct context *)save;
     return ret;
@@ -152,5 +170,5 @@ unsigned int start_elf(void)
     volatile struct context *ctx = __context;
 
     ctx = switch_to((struct context *)ctx);
-    return ctx->eax;
+    return ctx->rax;
 }
diff --git a/arch/amd64/context.h b/arch/amd64/context.h
index 4c3832e..4906346 100644
--- a/arch/amd64/context.h
+++ b/arch/amd64/context.h
@@ -2,39 +2,51 @@
 #define AMD64_CONTEXT_H
 
 struct context {
+    /* Spike 1: this frame was a THIRTY-TWO BIT one wearing a 64-bit arch's
+     * name -- edi/esi/ebp/esp/ebx/edx/ecx/eax as uint32_t, eip 32-bit, and a
+     * comment reading "accessed with pushal/popal", an instruction that does
+     * not exist in long mode. Every pointer stored here was silently truncated.
+     *
+     * Widened, and the registers renamed to what they actually are. The eight
+     * r8-r15 slots are new: a 64-bit frame that omits them is not a frame.
+     * Spike 2 owns the assembly that fills it; Spike 1 only needs it to hold a
+     * pointer without cutting it in half. */
+
     /* Stack Segment, placed here because of the alignment issue... */
     uint16_t ss;
-    /* Used with sgdt/lgdt */
+    /* Used with sgdt/lgdt -- 2 + 8 bytes in long mode, not 2 + 4 */
     uint16_t gdt_limit;
     uint64_t gdt_base;
-    /* General registers, accessed with pushal/popal */
-    uint32_t edi;
-    uint32_t esi;
-    uint32_t ebp;
-    uint32_t esp; /* points just below eax */
-    uint32_t ebx;
-    uint32_t edx;
-    uint32_t ecx;
-    uint32_t eax;
+
+    /* General registers */
+    uint64_t rdi;
+    uint64_t rsi;
+    uint64_t rbp;
+    uint64_t rsp; /* points just below rax */
+    uint64_t rbx;
+    uint64_t rdx;
+    uint64_t rcx;
+    uint64_t rax;
+    uint64_t r8, r9, r10, r11, r12, r13, r14, r15;
 #define ESP_LOC(ctx) (&(ctx)->gs)
-    /* Segment registers */
-    uint32_t gs;
-    uint32_t fs;
-    uint32_t es;
-    uint32_t ds;
+    /* Segment registers (64-bit slots; the registers themselves stay 16-bit) */
+    uint64_t gs;
+    uint64_t fs;
+    uint64_t es;
+    uint64_t ds;
     /* Flags */
-    uint32_t eflags;
+    uint64_t rflags;
     /* Code segment:offset */
-    uint32_t eip;
-    uint32_t cs;
+    uint64_t rip;
+    uint64_t cs;
     /* Optional stack contents */
-    uint32_t return_addr;
-    uint32_t param[0];
+    uint64_t return_addr;
+    ucell param[0];
 };
 
 /* Create a new context in the given stack */
 struct context *
-init_context(uint8_t *stack, uint32_t stack_size, int num_param);
+init_context(uint8_t *stack, uint64_t stack_size, int num_param);
 
 /* Switch context */
 struct context *switch_to(struct context *);
