# patches/08-amd64-spike1-trampoline.patch — SPIKE 1: the firmware runs in long mode.
#
# Applies on top of 01-x86-revival.patch. SUPERSEDES 02 and 03 (it contains the
# build-on and drift-fix work); do not apply those as well.
#
# Verified by: ./build-openbios.sh amd64 && ./smoke-openbios.sh amd64
#   0 > 3 4 + . 7  ok
#   0 > -1 u. ffffffffffffffff  ok        <- a 64-bit cell, on BARE METAL
#
# WHAT HAD TO BE TRUE, in the order the machine insisted on it:
#
#  1. switch.S rewritten. 116 lines of 32-bit assembly (pushal/popal, pushl %ds,
#     lret) lived in the 64-bit arch directory. Replaced by a trampoline: build a
#     PML4 identity-mapping the low 4 GiB with 2 MiB pages, set CR4.PAE, EFER.LME
#     and CR0.PG, far-jump through a descriptor with L=1.
#  2. SSE had to be enabled. SSE2 is BASELINE for x86-64 so gcc emits it unasked;
#     the first fault was #UD on a `movups %xmm0` gcc generated to copy a 16-byte
#     struct. Set CR0.MP, clear CR0.EM, set CR4.OSFXSR|OSXMMEXCPT, fninit.
#  3. The multiboot handoff had to be SAVED. %eax/%ebx carry the magic and the
#     info pointer, and building page tables is the first thing that destroys
#     them. Missing this is silent: it panics later with "no dictionary".
#  4. multiboot.h's WIRE-FORMAT structs used `unsigned long` -- 4 bytes on x86,
#     8 here -- so every field after the first was read at double its offset.
#  5. `dict_end - dict_start` is POINTER subtraction on `unsigned long *`: an
#     EIGHTH of the byte count. The dictionary checksummed over 1/8 of itself.
#  6. relocate() is a NO-OP now, and that is the biggest finding: the x86
#     firmware relocates by REBASING THE GDT DATA SEGMENT, and long mode IGNORES
#     segment bases. It is not a routine that needs porting; it is a strategy
#     that does not survive the port.
#  7. libgcc's 128-bit helpers were conditioned on SPARC64 next to a comment
#     reading CONDITION="CONFIG_64BITS" -- the right condition, hard-coded to the
#     only 64-bit arch that shipped. amd64 needs them: dcell is 128-bit.
#  8. elf_load.c's ofmem guard named the arches that were built, not amd64.
#  9. auto-boot? defaulted true, so the firmware banner'd and stopped WITHOUT a
#     prompt -- which reads exactly like a hang and is not one.
# 10. QEMU REFUSES an ELF64 multiboot image ("give a 32bit one"), so the build
#     now wraps the ELF64 in ELF32 headers with objcopy -> openbios.multiboot32.
#
# STUBBED, ON PURPOSE, AND LOUDLY: __switch_context/__exit_context halt rather
# than returning (Spike 2 owns context + exceptions), and linux_load() reports
# that it is stubbed (Spike 3 owns booting Linux). A context switch that
# silently did nothing would corrupt whatever ran next.

diff --git a/Makefile.target b/Makefile.target
index 6f2d264..22dd31e 100644
--- a/Makefile.target
+++ b/Makefile.target
@@ -24,6 +24,9 @@ AR     := $(TARGET)ar
 LD     := $(TARGET)ld
 NM     := $(TARGET)nm
 STRIP  := $(TARGET)strip
+# Spike 1: amd64 needs objcopy to wrap its ELF64 image in ELF32 headers --
+# QEMU's multiboot loader refuses an x86-64 ELF outright ("give a 32bit one").
+OBJCOPY := $(TARGET)objcopy
 RANLIB := $(TARGET)ranlib
 
 CFLAGS+= -Os -g -DNATIVE_BITWIDTH_EQUALS_HOST_BITWIDTH -USWAP_ENDIANNESS
diff --git a/arch/amd64/boot.c b/arch/amd64/boot.c
index 0e1fe7e..ee0fb78 100644
--- a/arch/amd64/boot.c
+++ b/arch/amd64/boot.c
@@ -1,27 +1,30 @@
-/*
+/* tag: openbios boot command for amd64 (Spike 1)
  *
+ * Ported from arch/x86/boot.c, which is the current twin of this file. The
+ * amd64 copy still #included libopenbios/elfload.h -- a header DELETED from
+ * the tree years ago -- and called elf_load(), which no longer exists. It
+ * compiled for eighteen years only in the sense that nothing ever compiled it.
+ *
+ * See the file "COPYING" for further information about
+ * the copyright and warranty status of this work.
  */
+
 #undef BOOTSTRAP
 #include "config.h"
 #include "libopenbios/bindings.h"
-#include "libopenbios/elfload.h"
 #include "arch/common/nvram.h"
 #include "libc/diskio.h"
+#include "libopenbios/initprogram.h"
 #include "libopenbios/sys_info.h"
-
-int elf_load(struct sys_info *, const char *filename, const char *cmdline);
-int linux_load(struct sys_info *, const char *filename, const char *cmdline);
-
-void boot(void);
+#include "libc/string.h"
+#include "boot.h"
 
 void boot(void)
 {
 	char *path=pop_fstr_copy(), *param;
 
-	// char *param="root=/dev/hda2 console=ttyS0,115200n8 console=tty0";
-
 	if(!path) {
-		printk("[x86] Booting default not supported.\n");
+		printk("[amd64] Booting default not supported.\n");
 		return;
 	}
 
@@ -31,11 +34,10 @@ void boot(void)
 		param++;
 	}
 
-	printk("[x86] Booting file '%s' with parameters '%s'\n",path, param);
+	printk("[amd64] Booting file '%s' with parameters '%s'\n",path, param);
 
-	if (elf_load(&sys_info, path, param) == LOADER_NOT_SUPPORT)
-		if (linux_load(&sys_info, path, param) == LOADER_NOT_SUPPORT)
-			printk("Unsupported image format\n");
+	if (linux_load(&sys_info, path, param) == LOADER_NOT_SUPPORT)
+		printk("Unsupported image format\n");
 
 	free(path);
 }
