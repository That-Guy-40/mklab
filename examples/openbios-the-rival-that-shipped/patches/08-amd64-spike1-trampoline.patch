-/* Load 32-bit part of kernel */
-static int load_linux_kernel(struct linux_header *hdr, uint32_t kern_addr)
-{
-    uint32_t kern_offset, kern_size;
-
-    if (hdr->setup_sects == 0)
-	hdr->setup_sects = 4;
