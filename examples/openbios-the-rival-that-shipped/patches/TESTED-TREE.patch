+extern struct _console_ops arch_console_ops;
+
+/* ---- a console device node -------------------------------------------
+ * x86 boots with NO console node: /chosen stdin and stdout were both 0.
+ * The firmware never noticed, because its own console is the low-level
+ * putchar in arch/x86/console.c -- but a CLIENT program can reach the
+ * console ONLY through those /chosen ihandles, so every write() it made
+ * went to ihandle 0 and vanished silently.
+ *
+ * Rather than enable drivers/pc_serial.c (whose uart_init collides with
+ * the one arch/x86/console.c already defines), wrap the console this arch
+ * ALREADY has in a node with open/read/write, and let /chosen point at it.
+ */
+static void obcon_open(int *idx)  { (void)idx; RET(-1); }
+static void obcon_close(int *idx) { (void)idx; }
+
+/* ( addr len -- actual ) */
+static void obcon_write(int *idx)
+{
+	int len = POP(), i;
+	const char *addr = (const char *)cell2pointer(POP());
+	(void)idx;
+	for (i = 0; i < len; i++)
+		arch_console_ops.putchar(addr[i]);
+	PUSH(len);
+}
+
+/* ( addr len -- actual ). Non-blocking, per IEEE 1275: return what is
+ * available, possibly 0. clib's getch() spins on exactly this. */
+static void obcon_read(int *idx)
+{
+	int len = POP(), n = 0;
+	char *addr = (char *)cell2pointer(POP());
+	(void)idx;
+	while (n < len && arch_console_ops.availchar())
+		addr[n++] = arch_console_ops.getchar();
+	PUSH(n);
+}
+
+DECLARE_UNNAMED_NODE(obcon, 0, sizeof(int));
+
+NODE_METHODS(obcon) = {
+	{ "open",  obcon_open  },
+	{ "close", obcon_close },
+	{ "write", obcon_write },
+	{ "read",  obcon_read  },
+};
+
+static void
+ob_console_init(void)
+{
+	push_str("/");
+	fword("find-device");
+	fword("new-device");
+	push_str("console");
+	fword("device-name");
+	push_str("serial");
+	fword("device-type");
+	BIND_NODE_METHODS(get_cur_dev(), obcon);
+	fword("finish-device");
+
+	/* Claim /chosen now. install-console runs later and tries
+	 * output-device ("screen"), which does not exist under -display none;
+	 * a failed `output` leaves stdout untouched and the CONSOLE-OUT
+	 * fallbacks skip when stdout is already set, so this survives. */
+	feval("\" /console\" input");
+	feval("\" /console\" output");
+}
+
+/* ---- `claim` for x86 -------------------------------------------------
+ * x86 shipped no cif-claim at all (only ppc and sparc64 bind one), so the
+ * IEEE 1275 `claim` service fell through ciface.fs's `else 3drop -1` and
+ * every client allocation failed. x86 has no ofmem, so this is a simple
+ * bump allocator over the free window -- enough for client programs, which
+ * claim a few buffers and exit.
+ *
+ * The window sizes itself: free RAM runs from 8 MiB (clear of load-base at
+ * 4 MiB) up to virtual 0, which is exactly where the client's own address
+ * window begins, just below the relocated firmware. Both ends move with
+ * virt_offset, so this is correct at any -m size.
+ */
+#define CLAIM_BASE_PHYS	0x800000UL
+
+static unsigned long claim_next = CLAIM_BASE_PHYS;
+
+/* TODO 17.3: /memory's `available` is the still-free part of THIS window, and
+ * it is republished on every claim and release rather than snapshotted at boot.
+ * The property describes a cursor that moves; publishing it once would be a
+ * record that outlives its subject the first time a client allocates. */
+static void
+x86_publish_available( void )
+{
+	publish_memory_available((unsigned long long)claim_next,
+				 (unsigned long long)virt_to_phys(0));
+}
+
+/* ( virt size align -- baseaddr|-1 ) */
+static void
+ciface_claim_x86( void )
+{
+	ucell align = POP(), size = POP(), virt = POP();
+	unsigned long base, limit;
+
+	if (virt) {		/* caller named an address; honour it */
+		PUSH(virt);
+		return;
+	}
+	if (align < 0x1000)
+		align = 0x1000;
+	base = (claim_next + align - 1) & ~((unsigned long)align - 1);
+	limit = virt_to_phys(0);
+	if (!size || base + size > limit || base + size < base) {
+		PUSH((ucell)-1);
+		return;
+	}
+	claim_next = base + size;
+	x86_publish_available();
+	/* Return it the way the client will use it: firmware-virtual, because
+	 * a client runs in the firmware's rebased segments (arch_init_program). */
+	PUSH((ucell)(uintptr_t)phys_to_virt(base));
+}
+
+/* ( virt size -- ). A bump allocator cannot free; releasing in LIFO order
+ * is the only case worth honouring, and clients exit immediately after. */
+static void
+ciface_release_x86( void )
+{
+	ucell size = POP(), virt = POP();
+	unsigned long base = virt_to_phys((void *)(uintptr_t)virt);
+
+	if (base + size == claim_next) {
+		claim_next = base;
+		x86_publish_available();
+	}
+}
+
+/* ------------------------------------------------------------------ *
+ * P0/P1: the NVRAM store.
+ *
+ * P0 replaced three stubs in entry.S that LIED -- arch_nvram_size returned 0
+ * and get/put were a bare `ret`, so a caller got silent success and an empty
+ * store. Nothing noticed for years because arch/x86 never called nvram_init().
+ *
+ * P1 gives the buffer a backing: raw sectors on a dedicated IDE drive. Note
+ * what this does NOT touch -- disk-label, pc-parts, and every filesystem in
+ * fs/ are read-only, and none of them is in the path. arch_nvram_* is arch
+ * code: it needs raw bytes at a fixed place, not a file. That is why the write
+ * path costs one function in the driver instead of five layers above it.
+ *
+ * THE DRIVE IS NOT GUESSED. LAB_NVRAM_DRIVE names a unit that the lab attaches
+ * on purpose and nothing else uses. Writing sectors on whatever happens to be
+ * unit 0 would eat the boot disk of anyone who ran this with a real image
+ * attached -- so the store REFUSES to write unless the drive it was handed
+ * still looks like the store (see nvram_backing_ok below). A gate after the
+ * write is a post-mortem, not a gate.
+ * ------------------------------------------------------------------ */
+#define LAB_NVRAM_DRIVE   3          /* secondary slave: ide@3 */
+#define LAB_NVRAM_SECTORS 16         /* 16 * 512 = 8 KiB */
+
+static char x86_nvram[LAB_NVRAM_SECTORS * 512];
+
+/*
+ * Refuse a drive that is carrying someone else's data. The store is either
+ * blank (a fresh image, all zeros) or already ours (nvram.c's partition format
+ * puts a signature byte and a 12-char name in the first 16 bytes, and the free
+ * partition it creates is named "77777777777"). Anything else -- a partition
+ * table, a filesystem superblock, a kernel -- and we keep the volatile buffer
+ * and say so, rather than overwrite it.
+ */
+static int nvram_backing_ok(const unsigned char *buf, int len)
+{
+	int i, blank = 1;
+
+	for (i = 0; i < len; i++)
+		if (buf[i]) { blank = 0; break; }
+	if (blank)
+		return 1;
+
+	/* nvram.c's own partition names, at the documented offsets */
+	if (!memcmp(buf + 4, "77777777777", 11))
+		return 1;
+	if (!memcmp(buf + 4, "common", 6))
+		return 1;
+
+	return 0;
+}
+
+/* ---- backing 2: CFI flash (a region the firmware OWNS) -------------- *
+ *
+ * The second backing on purpose, and deliberately UNLIKE the first: IDE is a
+ * PIO block device reached through I/O ports, flash is memory-mapped. Two
+ * backings that fail the same way would be one data point.
+ *
+ * QEMU maps `-drive if=pflash,unit=1` at physical 0xffbe0000 on -M pc (unit 0
+ * is the system flash, so the firmware image has to fill it -- SeaBIOS at the
+ * top of a 4 MiB image works and is what the lab's runner does). The device is
+ * cfi.pflash01: the INTEL command set, 4 KiB sectors, one byte per bus cycle.
+ *
+ * `romd` is the thing to understand here: reads come straight from the backing
+ * like RAM, but writes DO NOT. They go to the device's command state machine,
+ * so a write is unlock/erase/program/poll -- not a store. An earlier draft of
+ * this file's own documentation called it "two memcpys"; the read half was
+ * right and the write half was not.
+ *
+ * AND THE ADDRESS MUST GO THROUGH phys_to_virt(). arch/x86 relocates itself by
+ * rebasing the GDT data segment, so a constant physical address used raw lands
+ * somewhere else entirely -- exactly the bug that made `load-base` read back as
+ * zeros while every byte count looked correct.
+ */
+#define LAB_FLASH_PHYS   0xffbe0000UL
+#define CFI_SECTOR       4096
+#define CFI_STATUS_READY 0x80
+#define CFI_STATUS_ERR   0x3e
+
+static volatile unsigned char *lab_flash(void)
+{
+	return (volatile unsigned char *)phys_to_virt(LAB_FLASH_PHYS);
+}
+
+/* Ask the chip what it is. A CFI query answers "QRY" at 0x10..0x12; anything
+ * else and there is no flash there, which is how this stays safe on a machine
+ * that has no pflash unit attached. */
+static int lab_flash_present(void)
+{
+	volatile unsigned char *f = lab_flash();
+	int ok;
+
+	f[0] = 0x98;
+	ok = (f[0x10] == 'Q' && f[0x11] == 'R' && f[0x12] == 'Y');
+	f[0] = 0xff;                    /* back to read-array */
+	return ok;
+}
+
+static int lab_flash_wait(volatile unsigned char *f, int at)
+{
+	unsigned char st = 0;
+	int spin;
+
+	for (spin = 0; spin < 2000000; spin++) {
+		f[at] = 0x70;
+		st = f[at];
+		if (st & CFI_STATUS_READY)
+			break;
+	}
+	if (!(st & CFI_STATUS_READY) || (st & CFI_STATUS_ERR))
+		return 1;
+	return 0;
+}
+
+static int lab_flash_write(const unsigned char *buf, int len)
+{
+	volatile unsigned char *f = lab_flash();
+	int off, i;
+
+	for (off = 0; off < len; off += CFI_SECTOR) {
+		f[off] = 0x50;                  /* clear status */
+		f[off] = 0x20;                  /* block erase  */
+		f[off] = 0xd0;                  /* confirm      */
+		if (lab_flash_wait(f, off)) { f[0] = 0xff; return 1; }
+	}
+	for (i = 0; i < len; i++) {
+		f[i] = 0x40;                    /* program      */
+		f[i] = buf[i];
+		if (lab_flash_wait(f, i)) { f[0] = 0xff; return 1; }
+	}
+	f[0] = 0xff;
+	return 0;
+}
+
+/* ---- backing selection --------------------------------------------- */
+enum { NV_NONE = 0, NV_FLASH, NV_IDE, NV_FLOPPY };
+static int x86_nvram_backend;
+
+static const char *nv_backend_name(int b)
+{
+	switch (b) {
+	case NV_FLASH:  return "pflash@0xffbe0000";
+	case NV_IDE:    return "ide@3";
+	case NV_FLOPPY: return "floppy0";
+	default:        return "none";
+	}
+}
+
+int
+arch_nvram_size( void )
+{
+	return sizeof(x86_nvram);
+}
+
+void
+arch_nvram_get( char *buf )
+{
+	unsigned char *p = (unsigned char *)x86_nvram;
+
+	x86_nvram_backend = NV_NONE;
+
+	/* Flash first: it is the region the firmware owns, and its probe is a
+	 * CFI query rather than a guess, so asking costs nothing when absent. */
+	if (lab_flash_present()) {
+		memcpy(p, (const void *)lab_flash(), sizeof(x86_nvram));
+		if (nvram_backing_ok(p, sizeof(x86_nvram)))
+			x86_nvram_backend = NV_FLASH;
+		else
+			printk("nvram: pflash holds data that is not an nvram store"
+			       " -- refusing to write to it\n");
+	}
+
+	if (x86_nvram_backend == NV_NONE &&
+	    !ob_ide_read_blocks_nr(LAB_NVRAM_DRIVE, 0, p, LAB_NVRAM_SECTORS)) {
+		if (nvram_backing_ok(p, sizeof(x86_nvram)))
+			x86_nvram_backend = NV_IDE;
+		else
+			printk("nvram: ide@%d holds data that is not an nvram store"
+			       " -- refusing to write to it\n", LAB_NVRAM_DRIVE);
+	}
+
+	/* Floppy last, and only if the CONTROLLER answered. Note the ordering
+	 * rationale: it is the slowest of the three and the one most likely to
+	 * have no media in it, so it is the fallback rather than the default --
+	 * but it is tried BEFORE giving up, because a 1.44 MB image a human can
+	 * mount on the host is the most legible store of the three. */
+	if (x86_nvram_backend == NV_NONE) {
+		if (!ob_floppy_present()) {
+			printk("nvram: floppy0 controller did not answer\n");
+		} else {
+			int got = ob_floppy_read_raw((char *)p, 0, sizeof(x86_nvram));
+			if (got != (int)sizeof(x86_nvram))
+				printk("nvram: floppy0 read returned %d, wanted %d"
+				       " -- no media, or the read failed\n",
+				       got, (int)sizeof(x86_nvram));
+			else if (!nvram_backing_ok(p, sizeof(x86_nvram)))
+				printk("nvram: floppy0 holds data that is not an nvram"
+				       " store -- refusing to write to it\n");
+			else
+				x86_nvram_backend = NV_FLOPPY;
+		}
+	}
+
+	if (x86_nvram_backend == NV_NONE) {
+		printk("nvram: no backing store found -- using a volatile buffer\n");
+		memset(x86_nvram, 0, sizeof(x86_nvram));
+	} else {
+		printk("nvram: backed by %s\n", nv_backend_name(x86_nvram_backend));
+	}
+
+	memcpy( buf, x86_nvram, sizeof(x86_nvram) );
+}
+
+void
+arch_nvram_put( char *buf )
+{
+	int rc;
+
+	memcpy( x86_nvram, buf, sizeof(x86_nvram) );
+
+	switch (x86_nvram_backend) {
+	case NV_FLASH:
+		rc = lab_flash_write((unsigned char *)x86_nvram, sizeof(x86_nvram));
+		break;
+	case NV_IDE:
+		rc = ob_ide_write_blocks_nr(LAB_NVRAM_DRIVE, 0,
+		                            (unsigned char *)x86_nvram,
+		                            LAB_NVRAM_SECTORS);
+		break;
+	case NV_FLOPPY:
+		rc = (ob_floppy_write_raw(x86_nvram, 0, sizeof(x86_nvram))
