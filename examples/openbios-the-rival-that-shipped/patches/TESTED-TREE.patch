diff --git a/arch/amd64/exception.c b/arch/amd64/exception.c
new file mode 100644
index 0000000..e8ebdd0
--- /dev/null
+++ b/arch/amd64/exception.c
@@ -0,0 +1,189 @@
+/* tag: amd64 exception handling  (Spike 2)
+ *
+ * arch/x86 has had an exception.c since 2004; arch/amd64 never did -- the
+ * census recorded it as "still to author from scratch". This is the 64-bit
+ * counterpart, and it keeps the behaviour that makes x86's version useful:
+ * it does NOT halt. It names the fault, dumps the machine and the Forth
+ * engine's state, resets the stacks, and returns into the outer interpreter,
+ * so a mistake at the prompt costs you a message rather than the session.
+ *
+ * See the file "COPYING" for further information about
+ * the copyright and warranty status of this work.
+ */
+
+#include "config.h"
+#include "libopenbios/bindings.h"
+#include "asm/types.h"
+
+/* program counter */
+extern ucell            PC;
+
+extern unsigned char    *dict;
+extern cell             dicthead;
+extern ucell            *last;
+
+/* THE LAYOUT IS THE CONTRACT with the stubs in switch.S: fields ascend in the
+ * order the pushes leave them in memory. Getting it wrong here does not fail
+ * to compile -- it prints a plausible register dump full of the wrong values,
+ * which is worse than no dump at all. */
+struct eregs {
+	uint64_t r15, r14, r13, r12, r11, r10, r9, r8;
+	uint64_t rdi, rsi, rbp, rbx, rdx, rcx, rax;
+	uint64_t vector;
+	uint64_t error_code;
+	/* pushed by the CPU */
+	uint64_t rip;
+	uint64_t cs;
+	uint64_t rflags;
+	uint64_t rsp;
+	uint64_t ss;
+};
+
+static const char * const exception_names[] = {
+	"division by zero",
+	"single step",
+	"NMI",
+	"breakpoint",
+	"interrupt overflow",
+	"bound range exceeded",
+	"invalid opcode",
+	"device unavailable",
+	"double fault",
+	"FPU segment overrun",
+	"invalid TSS",
+	"segment not present",
+	"stack exception",
+	"general protection fault",
+	"page fault",
+	"reserved",
+	"floating point exception",
+	"alignment check",
+	"machine check exception",
+};
+
+/* The firmware's own stack top, from arch/amd64/ldscript. Recovery abandons
+ * the faulted stack and starts again on this one -- see restart_interpreter. */
+extern char _estack[];
+
+/* Set between the fault and the moment the interpreter is actually re-entered.
+ * A second fault inside that window would recurse forever on a fresh stack
+ * each time, printing the same dump until the console scrolls the original
+ * off; halting once is the honest answer. */
+static volatile int recovering;
+
+static void halt_forever(void)
+{
+	for (;;)
+		asm volatile ("cli; hlt");
+}
+
+/* Never returns. Entered by iretq on a FRESH STACK, with the faulted one
+ * abandoned entirely -- see the long note in amd64_exception. */
+static void restart_interpreter(void)
+{
+	recovering = 0;
+
+	rstackcnt = 0;
+	dstackcnt = 0;
+
+	PC = (ucell)findword("outer-interpreter");
+	enterforth((xt_t)PC);
+
+	/* The outer interpreter is a loop; reaching here means it fell out,
+	 * which recovery cannot paper over. Say so rather than returning into
+	 * a stack that no longer exists. */
+	printk("\nthe outer interpreter returned after a fault -- halting.\n");
+	halt_forever();
+}
+
+void amd64_exception(struct eregs *info);
+void amd64_exception(struct eregs *info)
+{
+	uint64_t cr2 = 0;
+	uint64_t sp;
+
+	if (info->vector <= 18)
+		printk("\nUnexpected Exception: %s", exception_names[info->vector]);
+	else
+		printk("\nUnexpected Exception: %d", (int)info->vector);
+
+	printk(" @ %02x:%016lx\n", (unsigned)info->cs, (unsigned long)info->rip);
+	printk("Code: %d  rflags: %016lx\n",
+	       (int)info->error_code, (unsigned long)info->rflags);
+
+	/* A page fault's faulting ADDRESS is the whole story, and it lives in
+	 * CR2 rather than on the stack. Printing the frame without it would
+	 * name the fault and hide what caused it. */
+	if (info->vector == 14) {
+		asm volatile ("movq %%cr2, %0" : "=r" (cr2));
+		printk("Faulting address: %016lx\n", (unsigned long)cr2);
+	}
+
+	printk("rax: %016lx rbx: %016lx rcx: %016lx rdx: %016lx\n",
+	       (unsigned long)info->rax, (unsigned long)info->rbx,
+	       (unsigned long)info->rcx, (unsigned long)info->rdx);
+	printk("rsi: %016lx rdi: %016lx rbp: %016lx rsp: %016lx\n",
+	       (unsigned long)info->rsi, (unsigned long)info->rdi,
+	       (unsigned long)info->rbp, (unsigned long)info->rsp);
+
+	printk("\ndict=0x%lx here=0x%lx(dict+0x%lx) pc=0x%lx(dict+0x%lx)\n",
+	       (unsigned long)(ucell)dict, (unsigned long)((ucell)dict + dicthead),
+	       (unsigned long)dicthead, (unsigned long)PC,
+	       (unsigned long)(PC - (ucell)dict));
+	printk("dstackcnt=%d rstackcnt=%d\n", dstackcnt, rstackcnt);
+
+	/* RECOVERY IS ONLY HONEST IF THERE IS SOMETHING TO RECOVER INTO.
+	 * If the dictionary is not loaded yet, findword() searches a NULL dict
+	 * and the "recovered" machine faults again immediately at rip=0 -- an
+	 * infinite fault loop that buries the ORIGINAL message under a hundred
+	 * copies of a later one. Measured while building this. Halt instead:
+	 * a fault before the interpreter exists is not survivable, and saying
+	 * so once is worth more than pretending a hundred times. */
+	if (!dict) {
+		printk("\nFault before the dictionary was loaded -- halting.\n");
+		halt_forever();
+	}
+
+	if (recovering) {
+		printk("\nA second fault arrived before the interpreter restarted"
+		       " -- halting.\n");
+		halt_forever();
+	}
+	recovering = 1;
+
+	/* THE FAULTED C STACK CANNOT BE RECOVERED THROUGH, and arch/x86's
+	 * handler -- which this was copied from -- has always tried to.
+	 *
+	 * Its shape is: zero the Forth stacks, point PC at the outer
+	 * interpreter, and resume at a do-nothing function so the C stack
+	 * unwinds back into enterforth's loop, which then runs the new PC.
+	 * The last step is the one that never happens. enterforth's loop is
+	 *
+	 *     tmp = rstackcnt; ... while (rstackcnt > tmp && ...) next();
+	 *
+	 * so setting rstackcnt = 0 makes that condition false for EVERY
+	 * enterforth frame on the stack. Measured here on 2026-08-23 with a
+	 * page fault at the prompt: the frame we returned into had tmp = 8,
+	 * exited without calling next() even once, and four more nested frames
+	 * unwound the same way. The carefully-chosen PC was never executed.
+	 * The machine survived, printed one " ok", and then accepted no input
+	 * -- alive and not listening, which is exactly the reported symptom.
+	 *
+	 * (The `+ sizeof(ucell)` this file used to carry was a separate error
+	 * in the other direction. kernel/forth.c:686 needs that offset because
+	 * next_dbg() has ALREADY advanced PC before calling the debugger;
+	 * next() advances it itself, so a handler that returns into the loop
+	 * must NOT pre-add it. Both spellings wedge identically -- measured --
+	 * because the loop is never reached either way.)
+	 *
+	 * So: do not return into it. iretq onto the firmware's own stack and
+	 * enter the outer interpreter from scratch. Nothing on the faulted
+	 * stack is worth keeping -- its invariants died with the fault -- and
+	 * abandoning it is what makes the recovery independent of where the
+	 * fault happened to land. */
+	sp = ((uint64_t)(uintptr_t)_estack) & ~0xFULL;
+	sp -= 8;		/* as a CALL would leave it: rsp % 16 == 8 */
+
+	info->rsp = sp;
+	info->rip = (uint64_t)(uintptr_t)&restart_interpreter;
+}
diff --git a/arch/amd64/init.fs b/arch/amd64/init.fs
index fda3acd..3b3505a 100644
--- a/arch/amd64/init.fs
+++ b/arch/amd64/init.fs
@@ -8,6 +8,54 @@ include config.fs
 
 " /" find-device
 
+\ TODO 17.1: TWO ADDRESS CELLS, on amd64 ONLY.
+\
+\ forth/device/tree.fs builds one root for every arch and gives it
+\ `#address-cells 1` and NO `#size-cells` at all. One address cell is 32 bits,
+\ so a 64-bit firmware could see all of a 5 GB machine and still not DESCRIBE
+\ it: libopenbios/init.c publishes /memory's `reg` from the counts declared
+\ here, and dropped the range at 0x100000000 -- honestly, by name, on every
+\ boot -- because nothing above 4 GiB fits in the cells the root was offering.
+\
+\ ONLY amd64. arch/x86 stays at one cell because one cell is ACCURATE there: a
+\ 32-bit firmware cannot form the address either way, so two cells would be a
+\ wider hole to say the same nothing in. The blast radius is per-arch for the
+\ same reason the capability is.
+\
+\ #size-cells IS DECLARED, not left to the defaults, and that closes a
+\ disagreement rather than opening one. Absent, this tree had TWO answers for
+\ it: forth/device/property.fs's my-#scells falls back to 1, while
+\ drivers/pci.c asks get_int_property() and got 0 -- which is why the PCI host
+\ bridge's `reg` was a lone address cell with no size beside it. Two readers,
+\ two answers, one silent property.
+\
+\ THE UNIT WORDS HAVE TO MOVE WITH THE COUNT. tree.fs's root decodes a unit
+\ address with `parse-hex` and encodes it with `tohexstr` -- one cell each way
+\ -- and forth/device/pathres.fs's (exact-match) compares exactly as many
+\ leading cells of a child's `reg` as decode-unit returned values. Leave these
+\ at one cell and every root child with a `reg` stops resolving by path.
+\ arch/sparc64/tree.fs does the same thing for the same reason (its
+\ encode-unit-upa / decode-unit-upa), which is the in-tree precedent for
+\ overriding a method the shared root already defined.
+\
+\ The two cells are the two halves of ONE 64-bit physical address, so the unit
+\ string stays a single hex number: /memory@0 and /ide@1 keep the names they
+\ had. sparc64 prints "id,lun" instead because there the two cells are two
+\ independent fields; here they are not.
+  2 " #address-cells" int-property
+  2 " #size-cells" int-property
+
+  : decode-unit ( str len -- phys.lo phys.hi )
+    parse-hex
+    dup h# ffffffff and         \ phys.lo
+    swap h# 20 rshift           \ phys.hi  ( h# 20 = 32: .fs sources compile in HEX )
+  ;
+
+  : encode-unit ( phys.lo phys.hi -- str len )
+    h# 20 lshift or
+    pocket tohexstr
+  ;
+
 new-device
   " memory" device-name
   \ 12230 encode-int " reg" property
@@ -49,11 +97,51 @@ finish-device
   else
     2drop
   then
+  \ arch/x86/init.fs:52 has this line and amd64's copy never did, so the LAST
+  \ preopen of the SYSTEM-initializer left /chosen active -- for the rest of the
+  \ boot and all the way to the prompt. Measured before this line existed:
+  \
+  \     0 > active-package u.   13d708
+  \     0 > pwd                 /chosen        ( x86: "no active device" )
+  \     0 > get-order .         2              ( x86: 1 )
+  \
+  \ active-package! (forth/device/package.fs) sets CURRENT to the active node's
+  \ method list, which is correct IEEE 1275 -- it is how `: open ... ;` inside
+  \ new-device becomes a node method. The consequence when nobody closes the
+  \ node is that EVERY definition made at the amd64 prompt landed in /chosen
+  \ and evaporated the moment anything called device-end:
+  \
+  \     0 > variable la  5 la !  la @ .    5  ok
+  \     0 > device-end  la @ .             la: undefined word.
+  \
+  \ Same shape as patches 14, 16 and 18, and the second of the two unbalanced
+  \ sites in this file -- line 9's `" /" find-device` is the other one. Each
+  \ arch got a different subset of the two right, which is why one defect kept
+  \ presenting as four unrelated symptoms.
+  \
+  \ NOT FIXED HERE: arch/sparc64/init.fs has the identical omission. This lab
+  \ cannot boot sparc, so it is recorded as an UNKNOWN rather than patched
+  \ blind -- see tools/check-patch-scope.sh, which would demand an Arch-tested:
+  \ line this lab cannot honestly write.
+  device-end
 ;
  
+\ WHEN this runs is the whole of it. set-defaults overwrites EVERY config
+\ variable with its compile-time default, so it has to run BEFORE the NVRAM
+\ store is read, never after. arch_init -- which calls nvconf_init() -- is
+\ registered from C as a PREPOST-initializer, and list-add APPENDS, so a
+\ PREPOST entry compiled into the dictionary here is reached first and the
+\ store's values land on top of the defaults, which is the intent.
+\
+\ As a SYSTEM-initializer (what x86, amd64 and ia64 all shipped) it runs in
+\ the NEXT list instead, i.e. AFTER nvconf_init has loaded the store -- so a
+\ perfectly good store was read, parsed, applied to /options, and then thrown
+\ away every boot. ppc/qemu, sparc32 and sparc64 -- the three arches anyone
+\ actually boots -- all say PREPOST-initializer here. The never-finished
+\ three copied the line into the wrong list.
 :noname
   set-defaults
-; SYSTEM-initializer
+; PREPOST-initializer
 
 \ preopen device nodes (and store the ihandles under /chosen)
 :noname
@@ -77,7 +165,31 @@ finish-device
