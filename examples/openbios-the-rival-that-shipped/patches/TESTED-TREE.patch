+/* publish_memory_ranges — put the firmware's memory map into /memory's `reg`.
+ *
+ * WHY THIS DID NOT EXIST. On ppc and sparc the `reg` on /memory is a by-product of
+ * ofmem, which those arches use heavily (20 references in arch/ppc, 6 in
+ * arch/sparc32). arch/x86 says outright that it has none -- "x86 has no ofmem, so
+ * this is a simple..." in its own openbios.c -- and arch/amd64 has zero references
+ * to it. So both x86 arches have always booted with a /memory node carrying
+ * nothing but its name, on EVERY path: multiboot and coreboot alike. Measured
+ * 2026-08-28 before writing a line of this, because "the coreboot path is missing
+ * it" and "nobody publishes it" are different bugs and only the second is true.
+ *
+ * THE CELL COUNTS ARE READ FROM THE ROOT, NOT ASSUMED. A `reg` is meaningless
+ * without the #address-cells/#size-cells that decode it, and this tree's root
+ * declares `#address-cells 1` and NO #size-cells at all -- so a hardcoded 2/2
+ * here would produce a property every consumer would misread. Absent counts fall
+ * back to the 1275 defaults (2 and 1), which is what my-#acells does elsewhere.
+ *
+ * A RANGE THAT DOES NOT FIT IS DROPPED AND SAID OUT LOUD, never truncated. With
+ * one address cell an address is 32 bits, and this lab routinely puts an NVDIMM at
+ * 0x100000000 -- silently writing the low half of that would be a property that
+ * looks valid and points somewhere else, which is the failure this codebase keeps
+ * finding. Dropping is a smaller lie than truncating, and printk makes it neither.
+ *
+ * Cells are BIG-ENDIAN, high cell first: 1275 property encoding, and the same trap
+ * drivers/pci.c documents after its builders handed set_property() raw host-order
+ * u32 arrays. */
+static u32 *emit_cells(u32 *p, unsigned long long v, int cells)
+{
+	int i;
+	for (i = cells - 1; i >= 0; i--)
+		*p++ = __cpu_to_be32((u32)(v >> (32 * i)));
+	return p;
+}
+
+/* The root's cell counts, ONE reader for every publisher below. Absent counts
+ * fall back to the 1275 defaults (2 and 1), which is what my-#acells and
+ * my-#scells do (forth/device/property.fs:221,234); disagreeing with the tree's
+ * own decoder is how a property becomes unreadable.
+ *
+ * Returns 0 on success. Anything outside 1..2 is a tree these were not written
+ * for, and a wrong property is worse than none. */
+static int memory_root_cells(int *acells, int *scells, const char *what)
+{
+	phandle_t root;
+	int retlen;
+	ucell v;
+
+	*acells = 2;
+	*scells = 1;
+	root = find_dev("/");
+	if (root) {
+		v = get_int_property(root, "#address-cells", &retlen);
+		if (retlen == (int)sizeof(u32))
+			*acells = (int)v;
+		v = get_int_property(root, "#size-cells", &retlen);
+		if (retlen == (int)sizeof(u32))
+			*scells = (int)v;
+	}
+	if (*acells < 1 || *acells > 2 || *scells < 1 || *scells > 2) {
+		printk("/memory: root declares #address-cells %d / #size-cells %d, "
+		       "which this does not encode -- leaving %s unset\n",
+		       *acells, *scells, what);
+		return -1;
+	}
+	return 0;
+}
+
+/* publish_memory_available -- /memory's `available`, the UNALLOCATED subset.
+ *
+ * WHY IT IS NOT PUBLISHED ONCE. `available` describes a cursor that MOVES: the
+ * whole point of the property is what is free NOW, and a snapshot taken at boot
+ * is a record that outlives its subject the first time a client claims. So the
+ * arch allocators call this again on every claim and every release, which is
+ * what libopenbios/ofmem_common.c's ofmem_update_memory_available() does for the
+ * arches that have ofmem. x86 and amd64 do not.
+ *
+ * IT IS DELIBERATELY NARROWER THAN "ALL UNALLOCATED RAM", and that direction is
+ * chosen. Both PC arches allocate with a bump allocator over ONE window, so any
+ * RAM outside that window -- everything above 4 GiB included -- is in `reg` and
+ * will be REFUSED by `claim`. Advertising it would be advertising memory the
+ * firmware will not give you, and a client that believes `available` and then
+ * gets -1 has been lied to. Under-reporting only costs a client an option it
+ * never had.
+ *
+ * An EMPTY window publishes a zero-length property rather than no property:
+ * "nothing is free" and "nobody has said" are different answers, and a client
+ * cannot tell them apart from an absent property. */
+void publish_memory_available(unsigned long long start, unsigned long long end)
+{
+	phandle_t mem;
+	u32 cells[4], *p;
+	int acells, scells;
+
+	mem = find_dev("/memory");
+	if (!mem)
+		return;
+	if (memory_root_cells(&acells, &scells, "available"))
+		return;
+
+	if (end <= start) {
+		set_property(mem, "available", (char *)cells, 0);
+		return;
+	}
+	/* A window this cannot encode is a window a client must not be told about:
+	 * truncating it would name a different region entirely. */
+	if ((acells == 1 && (start >> 32)) || (scells == 1 && ((end - start) >> 32))) {
+		/* %llx, not FMT_ucellx: ucell is 32 bits on x86 and the whole point
+		 * of this branch is a value that does not fit in 32. libc/vsprintf.c
+		 * implements long long (TODO 13.3(E), patch 30 ran it for the first
+		 * time). */
+		printk("/memory: the free window %llx..%llx does not fit "
+		       "#address-cells %d / #size-cells %d -- leaving available unset\n",
+		       start, end, acells, scells);
+		return;
+	}
+	p = emit_cells(cells, start, acells);
+	p = emit_cells(p, end - start, scells);
+	set_property(mem, "available", (char *)cells,
+		     (int)((p - cells) * sizeof(u32)));
+}
+
+void publish_memory_ranges(struct sys_info *info)
+{
+	phandle_t mem;
+	u32 *cells, *p;
+	int i, acells, scells, emitted = 0, dropped = 0;
+
+	if (!info || info->n_memranges <= 0)
+		return;
+	mem = find_dev("/memory");
+	if (!mem)
+		return;
+	if (memory_root_cells(&acells, &scells, "reg"))
+		return;
+
+	cells = malloc(info->n_memranges * (acells + scells) * sizeof(u32));
+	if (!cells)
+		return;
+	p = cells;
+	for (i = 0; i < info->n_memranges; i++) {
+		unsigned long long base = info->memrange[i].base;
+		unsigned long long size = info->memrange[i].size;
+		if ((acells == 1 && (base >> 32)) || (scells == 1 && (size >> 32))) {
+			dropped++;
+			continue;
+		}
+		p = emit_cells(p, base, acells);
+		p = emit_cells(p, size, scells);
+		emitted++;
+	}
+	if (emitted)
+		set_property(mem, "reg", (char *)cells, (int)((p - cells) * sizeof(u32)));
+	if (dropped)
+		printk("/memory: %d of %d range(s) NOT published -- the root declares "
+		       "#address-cells %d / #size-cells %d, so an address or size above "
+		       "4 GiB cannot be encoded here\n",
+		       dropped, info->n_memranges, acells, scells);
+	free(cells);
+}
diff --git a/libopenbios/initprogram.c b/libopenbios/initprogram.c
index 3213378..345abc4 100644
--- a/libopenbios/initprogram.c
+++ b/libopenbios/initprogram.c
@@ -114,9 +114,97 @@ void init_forth_context(void)
 {
 	/* Execute Forth payload */
 	printk("Evaluating Forth...\n");
-	fword("load-base");
-	feval("load-state >ls.file-size @");
-	fword("eval2");
+
+	/* LOCAL DIVERGENCE (mklab). Two defects on this path, both silent, and
+	 * both of which mean the Forth-source loader has never run a byte.
+	 *
+	 * (a) TWO RECORDS OF ONE FACT. The C loaders in libopenbios/load.c each
+	 *     set `load-state >ls.file-size` themselves, which is what this
+	 *     function reads. But `load` does not go through them: $load
+	 *     (forth/debugging/client.fs:135) calls the DEVICE PACKAGE's own
+	 *     `load` method and records the result with `!load-size`, which
+	 *     writes a separate `variable file-size` (client.fs:37-41). Nothing
+	 *     connects the two, so the size read here is 0 and the evaluation
+	 *     covers no bytes. Measured: load-base held `\ marker.." SPIK` while
+	 *     `load-state >ls.file-size @` printed 0.
+	 *
+	 *     Fall back rather than overwrite -- where a C loader has already
+	 *     filled the field in, that value is authoritative and is left alone.
+	 *
+	 * (b) `eval2` IS NOT DEFINED ANYWHERE IN THE TREE. This call site was its
+	 *     only occurrence; nothing defines it, and fword() on a missing word
+	 *     is silent, so the symptom was "Evaluating Forth..." followed by a
+	 *     clean ok. The real word is `evaluate` ( str len -- ),
+	 *     forth/bootstrap/interpreter.fs:163.
+	 *
+	 * The size selection is done in C and not in the feval string on purpose:
+	 * `if`/`then` are compile-only, so a fallback written as interpreted Forth
+	 * does not run -- and it fails exactly as silently as the bug it fixes,
+	 * which cost a build to notice. */
+	{
+		ucell size;
+
+		feval("load-state >ls.file-size @");
+		size = POP();
+		if (size == 0) {
+			feval("load-size");
+			size = POP();
+		}
+
+		/* A ZERO HERE IS A REFUSAL, NOT A NO-OP.
+		 *
+		 * `evaluate` of 0 bytes succeeds and prints nothing, so before
+		 * this a size that never got written looked exactly like a
+		 * payload that had nothing to say -- the same silence this
+		 * lab has now chased four times.
+		 *
+		 * The 0-means-unset test above is kept as belt and braces, but
+		 * it is no longer what makes this correct: client.fs now
+		 * ERASES load-state at creation and !load-size writes BOTH
+		 * records, so 0 finally means "nothing was loaded" rather than
+		 * "nobody wrote it down". It did not mean that before, and
+		 * that is precisely how `go` hung on x86: the field held
+		 * 0x30000000 of dictionary garbage, the fallback therefore did
+		 * not fire, and `evaluate` was handed 768 MB to interpret. */
+		if (size == 0) {
+			ucell fs, ls, lb;
+
+			/* Report the three values SEPARATELY. "both 0" cannot
+			 * distinguish "nothing was loaded" from "this context
+			 * cannot see what was loaded", and on x86 those are
+			 * different answers: at the prompt load-size reads
+			 * 0x1f, and here it reads 0. */
+			ucell xb, xs;
+
+			/* THE XTs DECIDE IT. If `load-base` resolves to the
+			 * SAME xt here as at the prompt but yields a different
+			 * number, the fetch of its body read a different cell
+			 * -- address translation. If the xt DIFFERS, a
+			 * different word resolved. A constant does NOT settle
+			 * this by itself: its value lives in the dictionary
+			 * and is fetched at execution time, through whatever
+			 * data segment is in effect. */
+			feval("load-state >ls.file-size @"); fs = POP();
+			feval("load-size");                  ls = POP();
+			feval("load-base");                  lb = POP();
+			feval("' load-base");                xb = POP();
+			feval("' load-size");                xs = POP();
+			printk("init-program: nothing to evaluate --"
+			       " ls.file-size=%lx load-size=%lx load-base=%lx"
+			       " xt(load-base)=%lx xt(load-size)=%lx"
+			       " -- no bytes were loaded, or this context"
+			       " cannot see them\n",
+			       (unsigned long)fs, (unsigned long)ls,
+			       (unsigned long)lb, (unsigned long)xb,
+			       (unsigned long)xs);
+			return;
+		}
+
+		fword("load-base");
+		PUSH(size);
+	}
+
+	fword("evaluate");
 }
 
 void go(void)
diff --git a/libopenbios/linuxbios.h b/libopenbios/linuxbios.h
index 0f7cba9..30ab9aa 100644
--- a/libopenbios/linuxbios.h
+++ b/libopenbios/linuxbios.h
@@ -55,9 +55,33 @@ struct lb_record {
 
 #define LB_TAG_MEMORY	0x0001
 
+/* THE COREBOOT TABLE IS A WIRE FORMAT, AND uint64_t IS NOT PORTABLE IN ONE.
+ *
+ * The System V i386 ABI aligns uint64_t to 4 bytes; the x86-64 ABI aligns it to
+ * 8. So `{ uint64_t; uint64_t; uint32_t; }` is 20 bytes when compiled 32-bit and
+ * 24 when compiled 64-bit -- four bytes of tail padding that exist in the READER
+ * and not in the table. coreboot emits 20-byte entries, so a 64-bit consumer of
+ * this header computed `size / 24` for the entry count and strode `map[i]` by 24
+ * over 20-byte records: the first entry read correctly and every one after it was
+ * garbage, which is what "RAM 0 MB" and a device tree with no memory came from.
+ *
+ * coreboot solved this on its own side and says so, in
+ * src/commonlib/include/commonlib/coreboot_tables.h:
+ *
+ *     /-* lb_uint64_t will keep 64bit coreboot table values aligned to 32bit
+ *      * to ensure compatibility. *-/
+ *     typedef __aligned(LB_ENTRY_ALIGN) uint64_t lb_uint64_t;   // LB_ENTRY_ALIGN 4
+ *
+ * This mirrors that typedef rather than reaching for __attribute__((packed)).
+ * Packing would give the same 20 bytes here by coincidence of this struct's
+ * shape; the aligned(4) typedef is the ABI, so it stays right for any other
+ * record that gains a 64-bit field later. Measured: natural 24 / packed 20 /
+ * this 20 on x86-64, and 20 / 20 / 20 on i386. */
+typedef uint64_t lb_uint64_t __attribute__((aligned(4)));
+
 struct lb_memory_range {
-	uint64_t start;
-	uint64_t size;
+	lb_uint64_t start;
+	lb_uint64_t size;
 	uint32_t type;
 #define LB_MEM_RAM       1	/* Memory anyone can use */
 #define LB_MEM_RESERVED  2	/* Don't use this memory region */
diff --git a/libopenbios/linuxbios_info.c b/libopenbios/linuxbios_info.c
index bef996c..d9ce7c5 100644
--- a/libopenbios/linuxbios_info.c
+++ b/libopenbios/linuxbios_info.c
@@ -109,9 +109,40 @@ static int find_lb_table(void *start, void *end, struct lb_header **result)
 	return 0;
 }
 
+/* Since ~2009 the table in low memory is only a stub whose single record
+ * (LB_TAG_FORWARD) points at the real table up in CBMEM. Without chasing
+ * it, read_lbtable() finds no LB_TAG_MEMORY and the caller falls back to
+ * the hardcoded 640K+31MB map — on any coreboot new enough to forward,
+ * this firmware thought every machine had 32 MB of RAM. */
+#define LB_TAG_FORWARD	0x0011
+struct lb_forward {
+	uint32_t tag;
+	uint32_t size;
+	uint64_t forward;
+};
+
+static int forward_lb_table(struct lb_header *head, struct lb_header **result)
+{
+	struct lb_record *rec;
+
+	for_each_lbrec(head, rec) {
+		if (rec->tag == LB_TAG_FORWARD) {
+			unsigned long addr;
+
+			addr = (unsigned long)
+				((struct lb_forward *) rec)->forward;
+			debug("Forwarding record -> %#lx\n", addr);
+			/* validate the forwarded location like any other */
+			return find_lb_table(phys_to_virt(addr),
+					     phys_to_virt(addr + 16), result);
+		}
+	}
+	return 0;
+}
+
 void collect_linuxbios_info(struct sys_info *info)
 {
-	struct lb_header *lb_table;
+	struct lb_header *lb_table, *fwd_table;
 	int found;
 	debug("Searching for LinuxBIOS tables...\n");
 	found = 0;
@@ -124,6 +155,9 @@ void collect_linuxbios_info(struct sys_info *info)
 	if (!found)
 		return;
 
+	if (forward_lb_table(lb_table, &fwd_table))
+		lb_table = fwd_table;
+
 	debug("Found LinuxBIOS table at: %p\n", lb_table);
 	info->firmware = "LinuxBIOS";
 	read_lbtable(lb_table, info);
