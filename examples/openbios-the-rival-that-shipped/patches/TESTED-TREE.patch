+ * be had, we say so and exit non-zero instead of continuing into an abort that
+ * used to exit 0 (TODO 18(b)) -- an honest failure the caller can see.
+ */
+#define OF_LOW_LIMIT   ((uintptr_t)1 << 32)
+
+static void *alloc_below_4g(size_t len, uintptr_t hint, const char *what)
+{
+	void *p = mmap((void *)hint, len, PROT_READ | PROT_WRITE,
+	               MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+
+	if (p == MAP_FAILED)
+		return NULL;
+
+	/* A hint is only a hint: verify, never assume. */
+	if ((uintptr_t)p + len > OF_LOW_LIMIT) {
+		printk("panic: %s landed at %p, above 4 GiB -- an ihandle there "
+		       "cannot be encoded into the four bytes IEEE 1275 gives an "
+		       "integer (5.3.5.1). See TODO 18.\n", what, p);
+		munmap(p, len);
+		return NULL;
+	}
