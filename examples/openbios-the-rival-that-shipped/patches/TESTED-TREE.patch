+		return 1;
+	if (!memcmp(buf + 4, "common", 6))
+		return 1;
+	return 0;
+}
+
+int arch_nvram_size(void)
+{
+	return sizeof(amd64_nvram);
+}
+
+void arch_nvram_get(char *buf)
+{
+	amd64_nvram_backed = 0;
+
+	if (pmem_present()) {
+		memcpy(amd64_nvram, (const void *)pmem(), sizeof(amd64_nvram));
+		if (nvram_backing_ok((unsigned char *)amd64_nvram, sizeof(amd64_nvram))) {
