+ * unverified by construction: "_eword()'s 'word not in the dictionary' branch
+ * is not watched to fire. It is reachable only if `evaluate` itself is
+ * missing, which cannot happen in a firmware that has reached the prompt."
+ *
+ * That is true of the CALLERS and false of the branch. eword() takes the word
+ * to run as an argument, so the branch is reachable by asking for any word that
+ * does not exist -- which is what this does. The distinction matters because
+ * the two failures are not the same failure: a -1 THROW means the word ran and
+ * aborted, while this means NOTHING RAN, and before the reporter existed both
+ * left ret == -1 and printed the same nothing.
+ *
+ * Leaves the stack as it found it, like the feval fixture: nargs is 0, so
+ * _eword has nothing to unwind even on the path that does run something.
+ */
+static void eword_report_selftest( void )
+{
+	static xt_t never_cached = 0;
+	(void)_eword("openbios-eword-selftest-no-such-word", &never_cached, 0);
+}
+
+/* THE PRECISION FIX'S OWN FIXTURE SET, run inside the shipped firmware.
+ *
+ * libc/vsprintf.c's %s case treated `precision` as a MINIMUM. Six of the seven
+ * cases below were wrong before that was corrected, and the seventh -- plain
+ * %s, no precision -- is the must-NOT-break control: a "fix" that routed the
+ * no-precision path through strnlen(s, -1) would still pass the other six.
+ *
+ * Run in the FIRMWARE and not on the host on purpose. libc/vsprintf.c is the
+ * target's printf; kernel/bootstrap.c #defines printk to the HOST printf under
+ * BOOTSTRAP, so a host harness would test glibc and report on OpenBIOS. Case 3
+ * is the one the tree actually contains: fs/hfsplus/hfsp_record.c prints a
+ * FourCC that is NOT NUL-terminated with `%4.4s`.
+ *
+ * ( -- )  prints one line per case and a ratio; leaves the stack alone.
+ */
+static void printf_precision_selftest( void )
+{
+	/* Deliberately NOT NUL-terminated within its first four bytes: this is
+	 * the hfsplus shape, and it is what makes a strlen-based clip unsafe. */
+	static const char fourcc[] = { 'A','B','C','D','X','Y','Z','!','\0' };
+	static const char *abcdef = "abcdef";
+	static const char *abc = "abc";
+	char got[32];
+	int ok = 0, n = 0;
+
+	/* THE RETURNED LENGTH IS CHECKED TOO, and the control is why.
+	 *
+	 * strcmp() stops at the first NUL, so it cannot see an over-read that
+	 * copies PAST one. Measured with the defect re-injected: `%.10s` on
+	 * "abc" wrote ten bytes -- "abc", the terminator, and six bytes of
+	 * whatever followed -- and strcmp(got, "abc") said EQUAL. The case that
+	 * most directly demonstrates the bug was the one case the fixture could
+	 * not see. vsnprintf() returns str-buf, i.e. what it actually produced,
+	 * so the length catches it: 10 against an expected 3. */
+#define PREC_CASE(label, want, ...) do {				\
+		int rc_ = snprintf(got, sizeof(got), __VA_ARGS__);	\
+		int good_ = !strcmp(got, (want))			\
+			    && rc_ == (int)strlen(want);		\
+		n++;							\
+		if( good_ )						\
+			ok++;						\
+		printk("printf-precision: %s want[%s](%d) got[%s](%d)"	\
+		       " %s\n", (label), (want), (int)strlen(want),	\
+		       got, rc_, good_ ? "OK" : "BAD");			\
+	} while(0)
+
+	/* 1-2: precision clips, and does not extend. */
+	PREC_CASE("clip",      "abc",       "%.3s",   abcdef);
+	PREC_CASE("no-extend", "abc",       "%.10s",  abc);
+	/* 3: the in-tree case -- four bytes of a buffer with no NUL in them. */
+	PREC_CASE("fourcc",    "ABCD",      "%4.4s",  fourcc);
+	/* 4: MUST NOT BREAK -- no precision at all. */
+	PREC_CASE("bare",      "abc",       "%s",     abc);
+	/* 5: zero precision prints nothing. */
+	PREC_CASE("zero",      "",          "%.0s",   abc);
+	/* 6-7: precision and field width are different things. */
+	PREC_CASE("left",      "abc     |", "%-8.3s|", abcdef);
+	PREC_CASE("right",     "     abc|", "%8.3s|",  abcdef);
+#undef PREC_CASE
+
+	printk("printf-precision: %d/%d ok\n", ok, n);
+}
+
+/* THE TWO GAPS TODO 13.1c NAMED AND DID NOT TEST.
+ *
+ * `test-printf-precision` covers %s only. Precision on an INTEGER conversion is
+ * a different thing entirely -- a MINIMUM digit count, zero-padded -- and it
+ * runs through number() rather than the %s case, a separate code path that the
+ * %s fix did not touch. vsnprintf's behaviour at the buffer edge is a third
+ * path again: the `if (str <= end)` guard and the return value.
+ *
+ * These REPORT before they assert. What C99 says and what this firmware does
+ * are two different questions, and the second is the one that matters to a
+ * caller here; a case that disagrees is a finding to record, not a conformance
+ * bug to silently "fix" in firmware something may already depend on.
+ *
+ * ( -- )  prints one line per case and a ratio; leaves the stack alone.
+ */
+static void printf_edges_selftest( void )
+{
+	char got[32];
+	char canary[8];
+	int ok = 0, n = 0, rc;
+	/* TODO 17.4 closed both recorded divergences on 2026-08-29, so these are
+	 * 0/0 -- and they STAY in the summary rather than being deleted. "0
+	 * recorded divergences" is a positive statement that somebody looked;
+	 * dropping the phrase would make a tree with a new, unrecorded
+	 * divergence print exactly what a conformant one prints. */
+	int ok_div = 0, n_div = 0;
+
+#define EDGE_CASE(label, want, ...) do {				\
+		int rc_ = snprintf(got, sizeof(got), __VA_ARGS__);	\
+		int good_ = !strcmp(got, (want))			\
+			    && rc_ == (int)strlen(want);		\
+		n++;							\
+		if( good_ )						\
+			ok++;						\
+		printk("printf-edges: %s want[%s](%d) got[%s](%d) %s\n",\
+		       (label), (want), (int)strlen(want), got, rc_,	\
+		       good_ ? "OK" : "BAD");				\
+	} while(0)
+
+	/* number(): precision is a MINIMUM digit count, zero-padded -- the
+	 * opposite sense to %s, on a different code path. */
+	EDGE_CASE("d-pad",   "00042", "%.5d",  42);
+	EDGE_CASE("d-star",  "007",   "%.*d",  3, 7);
+	EDGE_CASE("d-width", "  042", "%5.3d", 42);
+	EDGE_CASE("d-left",  "042  ", "%-5.3d", 42);
+	EDGE_CASE("x-pad",   "0ab",   "%.3x",  0xab);
+	/* C99 7.19.6.1: "For d, i, o, u, x, and X conversions, if a precision
+	 * is specified, the 0 flag is ignored." number() does not ignore it --
+	 * `c = (type & ZEROPAD) ? '0' : ' '` and the pad loop runs regardless
+	 * -- so these three ask whether that is actually reachable, rather than
+	 * asserting it from a read of the source. */
+	EDGE_CASE("plus-prec",    "+042",     "%+.3d",  42);
+	EDGE_CASE("hash-prec",    "0x0ab",    "%#.3x",  0xab);
+
+	/* The shape the tree ACTUALLY uses: arch/ppc/qemu/main.c:58-59 prints
+	 * four `%8.8lx` in the boot path, and that is the only integer
+	 * conversion with a precision anywhere outside this fixture. Test the
+	 * shipped shape, not a convenient stand-in. */
+	EDGE_CASE("lx-fits", "deadbeef", "%8.8lx", (unsigned long)0xdeadbeefUL);
+	EDGE_CASE("lx-pads", "000000ab", "%8.8lx", (unsigned long)0xabUL);
+
+	/* TODO 17.4 -- CLOSED 2026-08-29. This was a RECORDED DIVERGENCE for two
+	 * months and is now a conformance case, which is exactly the transition
+	 * the old fixture was built to make visible.
+	 *
+	 * C99 7.19.6.1p8: "if the value and the precision are both 0, no
+	 * characters are produced." number() did
+	 *
+	 *     i = 0;
+	 *     if (num == 0)
+	 *             tmp[i++] = '0';
+	 *
+	 * unconditionally, so `%.0d` of 0 printed "0". It now tests the
+	 * precision first.
+	 *
+	 * WHY IT WAS FIXED AFTER BEING PARKED TWICE. The parked reasoning was
+	 * "no in-tree caller, and it only mis-formats". Both still hold -- the
+	 * premise was RE-DERIVED on 2026-08-29 rather than trusted, and the only
+	 * %08.3d in the tree is this fixture itself. What the old note did not
+	 * weigh is §13.3(C): a printf that disagrees with C99 is a latent
+	 * "two printfs answering one call". GCC may constant-fold snprintf's
+	 * RETURN per C99 while our code writes different bytes, which is
+	 * precisely the ppc32 bug that cost a day. -fno-builtin now prevents it
+	 * on every arch -- but that is a mitigation one build-flag edit away
+	 * from being lost, and the divergence is the thing it mitigates.
+	 *
+	 * The buffer is still pre-poisoned with 'Q' so "wrote nothing" is
+	 * visible as itself rather than as a leftover, and wrote= and ret= are
+	 * still reported separately: they disagreed by ARCH once, and a single
+	 * number cannot say which half moved. */
+	got[0] = 'Q'; got[1] = 'Q'; got[2] = '\0';
+	rc = snprintf(got, sizeof(got), "%.0d", 0);
+	n++;
+	if( got[0] == '\0' && rc == 0 ) {
+		ok++;
+		printk("printf-edges: d-zero want[](0) got[%s](%d) ret=%d OK\n",
+		       got, (int)strlen(got), rc);
+	} else {
+		printk("printf-edges: d-zero want[](0) got[%s](%d) ret=%d BAD%s\n",
+		       got, (int)strlen(got), rc,
+		       rc == (int)strlen(got) ? "" : " RET-DISAGREES");
+	}
+
+	/* vsnprintf at the buffer edge. Not EDGE_CASE: these need a short buf,
+	 * and the interesting half is the RETURN -- C99 says "what would have
+	 * been written", so a caller sizing a second buffer from it is relying
+	 * on the untruncated length, not on what fit. */
+	/* The TRUNCATION IS THE SUBJECT UNDER TEST, so GCC's warning about it is
+	 * correct and unwanted here -- suppressed locally, beside the code it
+	 * excuses, and nowhere wider.
+	 *
+	 * Caught by the PPC CROSS-COMPILER and by neither host-native build:
+	 * `-Werror=format-truncation=` fired on ppc while amd64 and x86 compiled
+	 * this file clean. That is the Arch-tested: rule earning itself on an
+	 * arch-neutral change -- the two arches this lab develops on would have
+	 * shipped a tree that does not build on the third. */
+#if defined(__GNUC__) && __GNUC__ >= 7
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wformat-truncation"
+#endif
+	rc = snprintf(got, 4, "abcdef");
+	n++;
+	if( !strcmp(got, "abc") && rc == 6 ) ok++;
+	printk("printf-edges: trunc want[abc](6) got[%s](%d) %s\n",
+	       got, rc, (!strcmp(got, "abc") && rc == 6) ? "OK" : "BAD");
+
+	rc = snprintf(got, 1, "abc");
+	n++;
+	if( got[0] == '\0' && rc == 3 ) ok++;
+	printk("printf-edges: trunc1 want[](3) got[%s](%d) %s\n",
+	       got, rc, (got[0] == '\0' && rc == 3) ? "OK" : "BAD");
+
+#if defined(__GNUC__) && __GNUC__ >= 7
+#pragma GCC diagnostic pop
+#endif
+
+	/* size 0 must not touch the buffer at all. A canary, because "it
+	 * returned the right number" says nothing about whether it wrote. */
+	canary[0] = 'Z'; canary[1] = 'Z';
+	rc = snprintf(canary, 0, "abc");
+	n++;
+	if( canary[0] == 'Z' && rc == 3 ) ok++;
+	printk("printf-edges: size0 want[canary Z](3) got[canary %c](%d) %s\n",
+	       canary[0], rc,
+	       (canary[0] == 'Z' && rc == 3) ? "OK" : "BAD");
+
+	/* TODO 17.4 -- CLOSED 2026-08-29, the second of the two.
+	 *
+	 * C99 7.19.6.1p6: "For d, i, o, u, x, and X conversions, if a precision
+	 * is specified, the 0 flag is ignored." number() did not ignore it, so
+	 * `%08.3d` of 42 gave 00000042 where C99 gives "     042". It now clears
+	 * ZEROPAD whenever a precision was given.
+	 *
+	 * GCC REFUSED THE LITERAL ALL ALONG, which is what made this one more
+	 * than an opinion: -Werror=format= says "'0' flag ignored with precision
+	 * and '%d'". The compiler was right about the rule and this printf now
+	 * follows it. The warning is STILL suppressed here, and the reason has
+	 * inverted: it used to excuse testing divergent behaviour, and now
+	 * excuses writing a format GCC considers pointless in order to prove we
+	 * treat it the way GCC says it must be treated. */
+#if defined(__GNUC__)
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wformat"
+#endif
+	EDGE_CASE("zeropad-prec", "     042", "%08.3d", 42);
+#if defined(__GNUC__)
+#pragma GCC diagnostic pop
+#endif
+
+	/* TODO 17.4's third item, and the fixture §13.3(B) said it could not
+	 * write. number() did `num = -num` on a long long with no guard, so
+	 * LLONG_MIN was UNDEFINED BEHAVIOUR -- and the note left it unexercised
+	 * "because testing it would mean shipping the UB in a fixture", which
+	 * was correct. Fixing it first is what makes the test safe: the digits
+	 * now come from an unsigned accumulator, where the negation is defined
+	 * for every input. Written as -N-1 rather than as the literal, because
+	 * -9223372036854775808 is unary minus applied to a constant too large
+	 * for long long -- the same trap one level up.
+	 *
+	 * THIS CASE IS A CONFORMANCE CHECK, NOT A PROOF THE FIX MATTERS, and the
+	 * difference was measured rather than assumed. Re-injecting the old
+	 * signed `-num` leaves this line GREEN: on x86-64 GCC the undefined
+	 * negation happens to produce the two's-complement bit pattern, which is
+	 * the right magnitude. A test cannot observe the absence of UB -- that is
+	 * a property of the source. What the fix buys is the right to ship this
+	 * fixture at all, which §13.3(B) correctly declined to do while running
+	 * it meant triggering the UB. Recorded as an UNKNOWN in TODO §17.4, not
+	 * folded into the pass. */
+	EDGE_CASE("llmin", "-9223372036854775808", "%lld",
+		  -9223372036854775807LL - 1);
+#undef EDGE_CASE
+
+	/* TODO 13.3(E)'s "untested printf surface": %n, and a long long wider
+	 * than a cell. Both are implemented (libc/vsprintf.c case 'n' and the
+	 * 'L' qualifier, which `ll` also maps to) and neither had ever been
+	 * exercised -- an implemented-but-unrun conversion is an UNKNOWN, not a
+	 * pass.
+	 *
+	 * %n IS the return value, written through a pointer: it stores
+	 * str - buf at the point it appears. So this case asserts the same
+	 * quantity the trunc cases assert about rc, at a DIFFERENT moment --
+	 * mid-format rather than at the end -- which is the only way to catch a
+	 * str that is advanced correctly overall but not while running. */
+	{
+		int nn = -1;
+		n++;
+		rc = snprintf(got, sizeof(got), "ab%ncd", &nn);
+		if( nn == 2 && rc == 4 && !strcmp(got, "abcd") ) {
+			ok++;
+			printk("printf-edges: pct-n want[abcd](4) n=2"
+			       " got[%s](%d) n=%d OK\n", got, rc, nn);
+		} else {
+			printk("printf-edges: pct-n want[abcd](4) n=2"
+			       " got[%s](%d) n=%d MISMATCH\n", got, rc, nn);
+		}
+	}
+
+	/* A long long WIDER THAN A CELL, which is the case x86 cannot express on
+	 * its stack and can still print: the value below needs 60 bits. If the
+	 * 'L' qualifier were dropped, va_arg would read half of it and the low
+	 * word would come out as the whole number -- the same shape as 13.2(b),
+	 * one layer down. */
+	n++;
+	rc = snprintf(got, sizeof(got), "%llx", 0x123456789abcdefULL);
+	if( !strcmp(got, "123456789abcdef") && rc == 15 ) {
+		ok++;
+		printk("printf-edges: llx want[123456789abcdef](15)"
+		       " got[%s](%d) OK\n", got, rc);
+	} else {
+		printk("printf-edges: llx want[123456789abcdef](15)"
+		       " got[%s](%d) MISMATCH\n", got, rc);
+	}
+
+	printk("printf-edges: %d/%d ok, %d/%d recorded divergence\n",
+	       ok, n, ok_div, n_div);
+}
